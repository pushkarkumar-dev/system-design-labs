---
// Hub page: renders the guide entry "overview" (src/content/interviews/guide/overview.mdx).
import { getEntry, render } from 'astro:content';
import InterviewLayout from '../../components/interviews/InterviewLayout.astro';
import { interviewComponents } from '../../components/interviews/mdx';

const entry = await getEntry('guide', 'overview');
if (!entry) throw new Error('[interviews] src/content/interviews/guide/overview.mdx is missing.');
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<InterviewLayout
  title={entry.data.title}
  description={entry.data.description}
  researchedAt={entry.data.researchedAt}
  toc={toc.length >= 3 ? toc : []}
>
  <Content components={interviewComponents} />
</InterviewLayout>
