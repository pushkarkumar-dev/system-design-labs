---
// Walkthrough index: one family walkthrough per underlying problem, grouped by track, with
// how many of each track's questions have an answer card. Drafts appear only in `astro dev`
// or with PUBLIC_SHOW_DRAFTS=true.
import InterviewLayout from '../../../components/interviews/InterviewLayout.astro';
import WalkthroughCard from '../../../components/interviews/WalkthroughCard.astro';
import { loadInterviewData, isVisible, hasPublishedAnswer, visibleAnswer, SHOW_DRAFTS } from '../../../lib/interviews/data';
import { links } from '../../../lib/interviews/url';

const d = await loadInterviewData();
const visible = d.walkthroughs
  .filter(isVisible)
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title));
const TRACKS = [
  { id: 'ai-engineer', label: 'AI Engineer' },
  { id: 'ai-infra', label: 'AI Infra' },
  { id: 'cross', label: 'Both tracks' },
] as const;
const groups = TRACKS.map((t) => {
  const items = visible.filter((w) => w.data.track === t.id);
  const qids = [...new Set(items.flatMap((w) => w.data.basedOn.map((r) => r.id)))];
  const answered = qids.filter((id) => visibleAnswer(d, id)).length;
  return { ...t, items, questions: qids.length, answered };
}).filter((g) => g.items.length);
const drafts = visible.filter((w) => w.data.status === 'draft').length;
const totalQuestions = d.questions.length;
const publishedAnswers = d.questions.filter((q) => hasPublishedAnswer(d, q.id)).length;
---
<InterviewLayout
  title="Walkthroughs"
  description="Worked answers to reported Senior and Staff interview questions: scoping, the math, the design, failure modes, how Senior and Staff answers differ, and a lab that proves it."
  wide
>
  <p>
    Each walkthrough covers one family of questions from the <a href={links.questions()}>question bank</a>: one
    underlying problem that companies ask in different words. It follows a fixed skeleton, so you can practise the
    structure as well as the content, and it has a small-team version: what one engineer owning AI at a
    50–500 person company would build, buy or skip. Every question also gets a short answer card on its own page
    that links back to its family. Numbers come from formulas or from lab measurements that say where they were
    measured.
  </p>
  <p class="wt-stats">{publishedAnswers} of {totalQuestions} questions have a published answer card.</p>

  {SHOW_DRAFTS && drafts > 0 && (
    <p class="wt-draftnote">
      Showing {drafts} draft{drafts === 1 ? '' : 's'} because this is a dev build or PUBLIC_SHOW_DRAFTS=true.
      Drafts are not part of the published site.
    </p>
  )}

  {groups.length === 0 ? (
    <p class="wt-empty">No walkthroughs are published yet. They're being written; the <a href={links.questions()}>question bank</a> is complete in the meantime.</p>
  ) : groups.map((g) => (
    <section class="wt-group" aria-labelledby={`track-${g.id}`}>
      <h2 id={`track-${g.id}`}>{g.label}</h2>
      <p class="wt-groupstats">
        {g.items.length} famil{g.items.length === 1 ? 'y' : 'ies'} · {g.answered} of {g.questions} question{g.questions === 1 ? '' : 's'} answered
      </p>
      <div class="wt-grid">
        {g.items.map((w) => <WalkthroughCard w={w} />)}
      </div>
    </section>
  ))}
</InterviewLayout>

<style>
.wt-draftnote {
  font-size: 0.84rem;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
  border: 1px dashed color-mix(in srgb, var(--diff-advanced) 50%, transparent);
  border-radius: var(--r-sm);
  padding: 0.5rem 0.8rem;
}
.wt-empty { color: var(--ink-3); }
.wt-stats, .wt-groupstats {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.76rem;
  color: var(--ink-3);
}
.wt-groupstats { margin: -0.4rem 0 1rem; }
.wt-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  gap: 1rem;
}
</style>
