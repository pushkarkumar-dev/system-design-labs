---
// One walkthrough. Fails the build if its H2s don't match the skeleton for its format
// (src/lib/interviews/skeletons.ts) or a required component is missing.
// "Questions in this family" is inserted before "## Sources" by the WalkthroughH2 override.
import { getCollection, render } from 'astro:content';
import InterviewLayout from '../../../components/interviews/InterviewLayout.astro';
import LabRef from '../../../components/interviews/LabRef.astro';
import WalkthroughH2 from '../../../components/interviews/WalkthroughH2.astro';
import { interviewComponents } from '../../../components/interviews/mdx';
import { assertInterviewIntegrity } from '../../../lib/interviews/integrity';
import {
  loadInterviewData, isVisible, visibleAnswer, SHOW_DRAFTS, WALKTHROUGH_CTX, type Walkthrough, type WalkthroughCtx,
} from '../../../lib/interviews/data';
import {
  checkSkeleton, countFollowUps, hasPendingTake, MIN_FOLLOW_UPS, needsSmallTeam, REQUIRED_COMPONENTS, usesComponent,
  wordCount, WORD_RANGE,
} from '../../../lib/interviews/skeletons';
import { PLANNED_LABS } from '../../../lib/interviews/labStatus';
import { label } from '../../../lib/interviews/taxonomy';
import { links } from '../../../lib/interviews/url';

export async function getStaticPaths() {
  const all = await getCollection('walkthroughs');
  return all.filter(isVisible).map((w) => ({ params: { id: w.id }, props: { w } }));
}

const { w } = Astro.props as { w: Walkthrough };
const { data } = w;
const file = `src/content/interviews/walkthroughs/${w.id}.mdx`;

await assertInterviewIntegrity();
const { Content, headings } = await render(w);
const h2 = headings.filter((h) => h.depth === 2);

// ── Structure checks ──────────────────────────────────────────────────────
const smallTeam = needsSmallTeam(data.format, data.family);
const problems = checkSkeleton(data.format, h2.map((h) => h.text), { smallTeam });
const body = w.body ?? '';
for (const c of REQUIRED_COMPONENTS) {
  if (!usesComponent(body, c)) problems.push(`missing <${c}> (every walkthrough needs one)`);
}
const followUps = countFollowUps(body);
if (followUps < MIN_FOLLOW_UPS) problems.push(`has ${followUps} <FollowUp> item(s); needs at least ${MIN_FOLLOW_UPS}`);
const familyNote = data.family ? ', family "' + data.family + '"' : '';
if (problems.length) {
  throw new Error(
    `[interviews] Walkthrough "${w.id}" (${file}, format "${data.format}"${familyNote}) doesn't match the required structure:\n` +
    problems.map((p) => `  - ${p}`).join('\n'),
  );
}
const words = wordCount(body);
if (words < WORD_RANGE.min || words > WORD_RANGE.max) {
  console.warn(`[interviews] warning: walkthrough ${w.id} has about ${words} words (target ${WORD_RANGE.min}–${WORD_RANGE.max}).`);
}

// ── Meta ──────────────────────────────────────────────────────────────────
const d = await loadInterviewData();
const basedOn = data.basedOn.map((r) => d.questionById.get(r.id)!).filter(Boolean);
const answered = basedOn.filter((q) => visibleAnswer(d, q.id)).length;
const FORMAT = {
  design: 'Design', coding: 'Coding', estimation: 'Estimation', 'deep-dive': 'Deep dive', behavioral: 'Behavioral',
  narrative: 'Narrative',
} as const;
const LEVEL = { senior: 'Senior', staff: 'Staff', both: 'Senior + Staff' } as const;
const TRACK = { 'ai-engineer': 'AI Engineer', 'ai-infra': 'AI Infra', cross: 'Both tracks' } as const;
const isDraft = data.status === 'draft';

// A published walkthrough may keep <MyTake pending />: production drops the section.
const hideMyTake = !SHOW_DRAFTS && hasPendingTake(body);
const ctx: WalkthroughCtx = { w, hideMyTake };
(Astro.locals as Record<string, unknown>)[WALKTHROUGH_CTX] = ctx;
const components = { ...interviewComponents, h2: WalkthroughH2 };

const FAMILY_TOC = { slug: 'questions-in-this-family', text: 'Questions in this family', depth: 2 };
const toc = h2
  .filter((h) => !(hideMyTake && h.slug === 'my-take'))
  .flatMap((h) => (h.slug === 'sources' ? [FAMILY_TOC, h] : [h]));
---
<InterviewLayout
  title={data.title}
  description={data.summary}
  researchedAt={data.researchedAt}
  updatedAt={data.updatedAt}
  eyebrow="Walkthrough"
  toc={toc}
>
  <div slot="meta" class="wt-meta">
    {isDraft && <span class="wt-draft">Draft</span>}
    <span class="wt-pill">{FORMAT[data.format]}</span>
    <span class="wt-pill">{TRACK[data.track]}</span>
    <span class="wt-pill">{LEVEL[data.level]}</span>
    <span class="wt-pill">{data.timeboxMin} min</span>
    {data.rounds.map((r) => <span class="wt-pill">{label.round(r)}</span>)}
  </div>

  <a slot="aside" class="wt-back" href={links.walkthroughs()}>← All walkthroughs</a>

  {isDraft && (
    <p class="wt-draftnote" role="note">
      Draft: not published yet. It may be incomplete, and the author's take is still to be written.
    </p>
  )}

  <aside class="wt-brief" aria-label="What this walkthrough is based on">
    <div class="wt-brief-row">
      <p class="wt-k">Questions</p>
      <p class="wt-v">
        <a href="#questions-in-this-family">{basedOn.length} reported question{basedOn.length === 1 ? '' : 's'} in this family</a>
        {answered > 0 && <span class="wt-qmeta">{answered} with an answer card</span>}
      </p>
    </div>
    {data.smallTeamFocus && (
      <div class="wt-brief-row">
        <p class="wt-k">Small team</p>
        <p class="wt-v">{data.smallTeamFocus}</p>
      </div>
    )}
    {data.askedAt.length > 0 && (
      <div class="wt-brief-row">
        <p class="wt-k">Reported at</p>
        <p class="wt-v">
          {data.askedAt.map((c, i) => (
            <>{i > 0 && ', '}{d.companyById.has(c) ? <a href={links.company(c)}>{label.company(c)}</a> : label.company(c)}</>
          ))}
        </p>
      </div>
    )}
    {data.labs.length > 0 && (
      <div class="wt-brief-row">
        <p class="wt-k">Labs</p>
        <div class="wt-labs">
          {data.labs.map((l) => <LabRef lab={l.lab.id} role={l.role} note={l.note} />)}
        </div>
      </div>
    )}
    {data.gapLabs.length > 0 && (
      <div class="wt-brief-row">
        <p class="wt-k">No lab yet</p>
        <ul class="wt-gaps">
          {data.gapLabs.map((g) => <li>{PLANNED_LABS[g] ?? g} <span class="wt-planned">planned</span></li>)}
        </ul>
      </div>
    )}
  </aside>

  <article class="wt-article">
    <Content components={components} />
  </article>
</InterviewLayout>

<style>
.wt-meta { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.9rem; }
.wt-pill {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  padding: 0.08rem 0.55rem;
  border-radius: 999px;
  border: 1px solid var(--line-2);
  color: var(--ink-3);
}
.wt-draft {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.08rem 0.55rem;
  border-radius: 999px;
  border: 1px dashed currentColor;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
}
.wt-draftnote {
  font-size: 0.86rem;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
  border: 1px dashed color-mix(in srgb, var(--diff-advanced) 50%, transparent);
  border-radius: var(--r-sm);
  padding: 0.5rem 0.8rem;
}
.wt-back {
  display: block;
  margin-top: 0.875rem;
  padding-top: 0.875rem;
  border-top: 1px solid var(--line);
  font-size: 0.78rem;
}
.wt-brief {
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-card);
  padding: 0.9rem 1.1rem;
  margin: 0 0 2rem;
  display: grid;
  gap: 0.9rem;
  font-size: 0.88rem;
}
.wt-k {
  font-size: 0.66rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin: 0 0 0.3rem;
}
.wt-v { margin: 0; }
.wt-gaps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
.wt-gaps li { margin: 0; }
.wt-qmeta { margin-left: 0.5rem; font-size: 0.76rem; color: var(--ink-3); }
.wt-labs :global(.labref) { margin: 0 0 0.5rem; }
.wt-planned {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.66rem;
  color: var(--ink-4);
  border: 1px dashed var(--line-2);
  border-radius: 999px;
  padding: 0 0.4rem;
  margin-left: 0.3rem;
}
</style>
