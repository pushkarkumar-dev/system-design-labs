---
// Guide chapters rendered from src/content/interviews/guide/<page>.mdx.
// The list is explicit so a stray guide file can't shadow questions/companies/walkthroughs.
import { getEntry, render } from 'astro:content';
import InterviewLayout from '../../components/interviews/InterviewLayout.astro';
import { interviewComponents } from '../../components/interviews/mdx';

export async function getStaticPaths() {
  return ['ai-engineer', 'ai-infra', 'ai-native', 'transition'].map((page) => ({ params: { page } }));
}

const { page } = Astro.params;
const entry = await getEntry('guide', page!);
if (!entry) throw new Error(`[interviews] src/content/interviews/guide/${page}.mdx is missing.`);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<InterviewLayout
  title={entry.data.title}
  description={entry.data.description}
  researchedAt={entry.data.researchedAt}
  toc={toc.length >= 3 ? toc : []}
>
  <Content components={interviewComponents} />
</InterviewLayout>
