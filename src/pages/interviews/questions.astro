---
// Full question bank. Server-rendered and usable with JS off; the filter bar is hidden
// until src/scripts/chip-filter.ts runs. URL params: track, theme, round, company, src, conf, q.
import InterviewLayout from '../../components/interviews/InterviewLayout.astro';
import QuestionList from '../../components/interviews/QuestionList.astro';
import SourceTag from '../../components/interviews/SourceTag.astro';
import ChipGroup from '../../components/ui/ChipGroup.astro';
import { loadInterviewData } from '../../lib/interviews/data';
import { CONFIDENCE, ROUNDS, SOURCE_TYPES, THEMES, label } from '../../lib/interviews/taxonomy';
import { links } from '../../lib/interviews/url';

const d = await loadInterviewData();
const qs = d.questions;
const total = qs.length;

const count = <T extends string>(values: T[]) => {
  const m = new Map<T, number>();
  for (const v of values) m.set(v, (m.get(v) ?? 0) + 1);
  return m;
};
const ordered = (keys: readonly string[], m: Map<string, number>, lab: (k: string) => string) =>
  keys.filter((k) => m.has(k)).map((k) => ({ value: k, label: lab(k), count: m.get(k)! }));

const trackCounts = new Map<string, number>([
  ['ai-engineer', qs.filter((q) => q.data.track !== 'ai-infra').length],
  ['ai-infra', qs.filter((q) => q.data.track !== 'ai-engineer').length],
]);
const trackOpts = ordered(['ai-engineer', 'ai-infra'], trackCounts, label.track);
const themeOpts = ordered(THEMES, count(qs.map((q) => q.data.theme as string)), label.theme);
const roundOpts = ordered(ROUNDS, count(qs.flatMap((q) => q.data.rounds as string[])), label.round);
const srcOpts = ordered(SOURCE_TYPES, count(qs.flatMap((q) =>
  [...new Set(q.data.sources.map((s) => d.sourceById.get(s.id)?.data.type).filter(Boolean) as string[])])), label.sourceType);
const confOpts = ordered(CONFIDENCE, count(qs.map((q) => q.data.confidence as string)), label.confidence);
const companyCounts = count(qs.flatMap((q) => q.data.companies as string[]));
const companyOpts = [...companyCounts]
  .map(([value, n]) => ({ value, label: label.company(value), count: n }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const sourceTypeHelp: [string, string][] = [
  ['official', 'company careers page, blog or policy'],
  ['first-hand', "a candidate's own account"],
  ['aggregator', 'candidate-submitted bank; only the title counts as reported'],
  ['secondary', 'prep-site article'],
  ['news', 'news coverage'],
  ['snippet', 'page blocked; only a search snippet was seen'],
];
---
<InterviewLayout
  title="Question bank"
  description="Interview questions that Senior and Staff candidates report for AI Engineer and AI Infra roles, paraphrased, each with its sources, source type and confidence."
  wide
>
  <section class="qintro">
    <p>
      Each row is a question candidates reported, paraphrased, with the date it was reported and every source
      we used. Company processes change and many reports are anonymous, so read the confidence pill before you
      plan around a row. The <a href={links.hub()}>overview</a> explains how this was researched and its limits.
    </p>
    <details class="qlegend">
      <summary>How to read source types and confidence</summary>
      <ul>
        {sourceTypeHelp.map(([t, help]) => <li><SourceTag type={t} /> {help}</li>)}
        <li><SourceTag confidence="low" /> a single anonymous report, or snippets only</li>
        <li><SourceTag confidence="medium" /> one first-hand account, or aggregator and secondary sources only</li>
        <li><SourceTag confidence="high" /> an official source, or several independent first-hand accounts</li>
      </ul>
    </details>
  </section>

  <div class="qfilter" data-chip-filter="#question-bank" data-count-noun="question|questions" hidden>
    <div class="qfilter-row">
      <ChipGroup name="track" label="Track" options={trackOpts} />
      <ChipGroup name="conf" label="Confidence" options={confOpts} allLabel="Any" />
      <ChipGroup name="src" label="Source type" options={srcOpts} allLabel="Any" />
    </div>
    <details class="qfilter-more" data-qfilter-more>
      <summary>Theme, round and company</summary>
      <div class="qfilter-more-body">
        <ChipGroup name="theme" label="Theme" options={themeOpts} />
        <ChipGroup name="round" label="Round" options={roundOpts} allLabel="Any" />
        <ChipGroup name="company" label="Company" options={companyOpts} allLabel="Any" />
      </div>
    </details>
    <div class="qfilter-search">
      <label class="qfilter-label" for="question-search">Search</label>
      <input
        id="question-search"
        type="search"
        class="qfilter-input"
        placeholder="kv cache, batching, rag…"
        autocomplete="off"
        spellcheck="false"
        data-filter-search="q"
      />
      <button type="button" class="qfilter-clear" data-filter-clear>Clear all</button>
    </div>
  </div>

  <div id="question-bank" class="qbank">
    <p class="qcount" data-filter-count aria-live="polite">{total} question{total === 1 ? '' : 's'}</p>
    <QuestionList bank level={2} />
    <p class="qempty" data-filter-empty hidden>
      No questions match these filters. <button type="button" class="qempty-clear" data-filter-clear>Clear all filters</button>
    </p>
  </div>
</InterviewLayout>

<script>
  // Open the secondary filter row when the URL already uses one of its params.
  const more = document.querySelector<HTMLDetailsElement>('[data-qfilter-more]');
  if (more && /[?&](theme|round|company)=/.test(location.search)) more.open = true;
</script>

<style>
.qintro p { margin-bottom: 0.75rem; }
.qlegend { margin: 0 0 1.5rem; font-size: 0.86rem; }
.qlegend summary { cursor: pointer; color: var(--ink-3); }
.qlegend ul { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.35rem; }
.qlegend li { margin: 0; color: var(--ink-2); }

.qfilter {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  padding: 1rem 1.15rem;
  margin: 0 0 1.25rem;
}
.qfilter:not([hidden]) { display: grid; gap: 0.9rem; }
.qfilter-row { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
.qfilter-more summary {
  cursor: pointer;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
}
.qfilter-more-body { display: grid; gap: 0.9rem; margin-top: 0.75rem; }
.qfilter-search { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.75rem; }
.qfilter-label {
  flex-basis: 100%;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
}
.qfilter-input {
  background: var(--bg);
  border: 1px solid var(--line-2);
  border-radius: var(--r-sm);
  color: var(--ink);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  padding: 0.35rem 0.75rem;
  flex: 1 1 10rem;
  min-width: 0;
  max-width: 22rem;
}
.qfilter-input:focus { border-color: var(--accent-line); }
.qfilter-input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
.qfilter-clear { flex: none; }
.qfilter-input::placeholder { color: var(--ink-4); }
.qfilter-clear, .qempty-clear {
  background: none;
  border: none;
  color: var(--accent);
  cursor: pointer;
  font: inherit;
  font-size: 0.8rem;
  text-decoration: underline;
  padding: 0;
}
.qfilter-clear:not([data-active]) { visibility: hidden; }
.qcount { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--ink-3); margin: 0 0 1rem; }
.qempty { text-align: center; padding: 3rem 0; color: var(--ink-3); }

/* The filter hides rows with the hidden attribute; make sure component CSS can't undo it. */
.qbank :global([data-filter-item][hidden]),
.qbank :global([data-filter-section][hidden]) { display: none !important; }
</style>
