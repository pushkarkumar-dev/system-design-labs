---
// One page per reported question: the question with its sources, its answer card
// (src/content/interviews/answers/<id>.mdx) and a Family box linking the family
// walkthrough and the sibling questions. Draft cards show only in `astro dev` or with
// PUBLIC_SHOW_DRAFTS=true; otherwise the page says the answer is coming.
// The bank itself is src/pages/interviews/questions.astro (/interviews/questions/).
import { getCollection, render } from 'astro:content';
import InterviewLayout from '../../../components/interviews/InterviewLayout.astro';
import FamilyQuestions from '../../../components/interviews/FamilyQuestions.astro';
import LabRef from '../../../components/interviews/LabRef.astro';
import SourceTag from '../../../components/interviews/SourceTag.astro';
import { interviewComponents } from '../../../components/interviews/mdx';
import { assertInterviewIntegrity } from '../../../lib/interviews/integrity';
import {
  companyNames, familyOf, formatDate, loadInterviewData, visibleAnswer, type Question,
} from '../../../lib/interviews/data';
import { checkAnswerSkeleton } from '../../../lib/interviews/skeletons';
import { label } from '../../../lib/interviews/taxonomy';
import { links } from '../../../lib/interviews/url';

export async function getStaticPaths() {
  const qs = await getCollection('interviewQuestions');
  return qs.map((q) => ({ params: { id: q.id }, props: { q } }));
}

const { q } = Astro.props as { q: Question };
const { data } = q;

await assertInterviewIntegrity();
const d = await loadInterviewData();

// ── Answer card ───────────────────────────────────────────────────────────
const card = visibleAnswer(d, q.id);
const rendered = card ? await render(card) : undefined;
const cardH2 = (rendered?.headings ?? []).filter((h) => h.depth === 2);
if (card) {
  const problems = checkAnswerSkeleton(cardH2.map((h) => h.text));
  if (problems.length) {
    throw new Error(
      `[interviews] Answer card src/content/interviews/answers/${card.id}.mdx doesn't match the required structure:\n` +
      problems.map((p) => `  - ${p}`).join('\n'),
    );
  }
}
const CardContent = rendered?.Content;
const isDraftCard = card?.data.status === 'draft';

// ── Family ────────────────────────────────────────────────────────────────
const family = familyOf(d, q.id);
const siblings = family ? family.data.basedOn.filter((r) => r.id !== q.id).length : 0;

// ── Question meta ─────────────────────────────────────────────────────────
const names = companyNames(q);
const companies = data.companies.map((c, i) => ({ id: c, name: names[i], hasCard: d.companyById.has(c) }));
const sources = data.sources.map((r) => d.sourceById.get(r.id)).filter((s) => !!s);
const labIds = [...new Set([...(card?.data.labs ?? []).map((r) => r.id), ...data.labs.map((r) => r.id)])]
  .filter((id) => d.labById.has(id));
const researchedAt = sources.map((s) => s.data.accessed).sort().at(-1);
const rounds = data.rounds.map(label.round);

const short = data.prompt.length > 72 ? `${data.prompt.slice(0, 70).replace(/\s+\S*$/, '')}…` : data.prompt;
const description =
  `${rounds.join(' / ')} question reported at ${names.join(', ')} (${formatDate(data.reportedAt)}). ` +
  (card ? 'Sources, confidence and an answer card.' : 'Sources and confidence; the answer card is being written.');

const toc = card
  ? [...cardH2, ...(family ? [{ slug: 'question-family', text: 'Family', depth: 2 }] : [])]
  : [];
---
<InterviewLayout
  title={data.prompt}
  docTitle={`${short} (${q.id})`}
  description={description}
  researchedAt={researchedAt}
  updatedAt={card?.data.updatedAt}
  eyebrow="AI Interviews · Question"
  toc={toc}
  compactTitle
>
  <div slot="meta" class="qp-meta">
    {isDraftCard && <span class="qp-draft">Draft answer</span>}
    <span class="qp-pill qp-pill--id">{q.id}</span>
    <span class="qp-pill">{label.track(data.track)}</span>
    <span class="qp-pill">{label.theme(data.theme)}</span>
    {data.rounds.map((r) => <span class="qp-pill">{label.round(r)}</span>)}
    {data.levels.map((l) => <span class="qp-pill">{label.level(l)}</span>)}
    <SourceTag confidence={data.confidence} />
  </div>

  <a slot="aside" class="qp-back" href={links.question(q.id)}>← In the question bank</a>

  <aside class="qp-brief" aria-label="Where this question was reported">
    <div class="qp-row">
      <p class="qp-k">Reported at</p>
      <p class="qp-v">
        {companies.map((c, i) => <>{i > 0 && ', '}{c.hasCard ? <a href={links.company(c.id)}>{c.name}</a> : c.name}</>)}
        <span class="qp-sub">{formatDate(data.reportedAt)}{data.levels.length === 0 && ' · level not stated'}</span>
      </p>
    </div>
    {data.staffSignal && (
      <div class="qp-row">
        <p class="qp-k">Staff signal</p>
        <p class="qp-v">{data.staffSignal}</p>
      </div>
    )}
    <div class="qp-row">
      <p class="qp-k">Sources</p>
      <ul class="qp-sources">
        {sources.map((s) => (
          <li>
            <a href={s.data.url} target="_blank" rel="noopener">{s.data.publisher}</a>
            <span class="qp-stitle">{s.data.title}</span>
            {s.data.published && <span class="qp-sub">{formatDate(s.data.published)}</span>}
            <SourceTag type={s.data.type} />
          </li>
        ))}
      </ul>
    </div>
    {labIds.length > 0 && (
      <div class="qp-row">
        <p class="qp-k">Prepare with</p>
        <p class="qp-v qp-labs">{labIds.map((id) => <LabRef lab={id} inline />)}</p>
      </div>
    )}
  </aside>

  {card && CardContent ? (
    <>
      {isDraftCard && (
        <p class="qp-draftnote" role="note">Draft: this answer card isn't published yet and may be incomplete.</p>
      )}
      <article class="qp-card">
        <CardContent components={interviewComponents} />
      </article>
    </>
  ) : (
    <div class="qp-coming" role="note">
      <p class="qp-coming-title">Answer coming</p>
      <p>
        The answer card for this question is being written.
        {family
          ? <> Until then, its family walkthrough covers the underlying problem: <a href={links.walkthrough(family.id)}>{family.data.title}</a>.</>
          : <> In the meantime, browse the <a href={links.walkthroughs()}>walkthroughs</a>.</>}
      </p>
    </div>
  )}

  {family && (
    <section class="qp-family" aria-labelledby="question-family">
      <h2 id="question-family">Family</h2>
      <div class="qp-family-box">
        <p class="qp-family-head">
          <a class="qp-family-title" href={links.walkthrough(family.id)}>{family.data.title}</a>
          {family.data.status === 'draft' && <span class="qp-draft">Draft</span>}
        </p>
        <p class="qp-family-summary">{family.data.summary}</p>
        {siblings > 0 ? (
          <>
            <p class="qp-k">Other questions in this family</p>
            <FamilyQuestions w={family} exclude={q.id} bare />
          </>
        ) : (
          <p class="qp-sub">No other reported questions in this family yet.</p>
        )}
      </div>
    </section>
  )}
</InterviewLayout>

<style>
.qp-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-top: 0.9rem; }
.qp-pill {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  padding: 0.08rem 0.55rem;
  border-radius: 999px;
  border: 1px solid var(--line-2);
  color: var(--ink-3);
}
.qp-pill--id { color: var(--ink-2); }
.qp-draft {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.05rem 0.5rem;
  border-radius: 999px;
  border: 1px dashed currentColor;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
}
.qp-draftnote {
  font-size: 0.86rem;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
  border: 1px dashed color-mix(in srgb, var(--diff-advanced) 50%, transparent);
  border-radius: var(--r-sm);
  padding: 0.5rem 0.8rem;
}
.qp-back {
  display: block;
  margin-top: 0.875rem;
  padding-top: 0.875rem;
  border-top: 1px solid var(--line);
  font-size: 0.78rem;
}
.qp-brief {
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-card);
  padding: 0.9rem 1.1rem;
  margin: 0 0 2rem;
  display: grid;
  gap: 0.9rem;
  font-size: 0.88rem;
}
.qp-k {
  font-size: 0.66rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin: 0 0 0.3rem;
}
.qp-v { margin: 0; }
.qp-sub { margin-left: 0.5rem; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--ink-3); }
.qp-sources { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
.qp-sources li { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.5rem; }
.qp-stitle { color: var(--ink-3); font-size: 0.82rem; flex-basis: 100%; order: 3; }
.qp-labs { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; }
.qp-coming {
  border: 1px dashed var(--line-2);
  border-radius: var(--r-md);
  padding: 0.9rem 1.1rem;
  color: var(--ink-2);
}
.qp-coming p { margin: 0; }
.qp-coming .qp-coming-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
  margin-bottom: 0.35rem;
}
.qp-family { margin-top: 2.5rem; }
.qp-family-box {
  border: 1px solid var(--accent-line);
  border-radius: var(--r-md);
  padding: 0.9rem 1.1rem;
  display: grid;
  gap: 0.6rem;
}
.qp-family-box p { margin: 0; }
.qp-family-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
.qp-family-title { font-weight: 600; font-size: 1.02rem; }
.qp-family-summary { color: var(--ink-3); font-size: 0.9rem; }
</style>
