---
// Company loops: AI-tool policy at a glance, then one card per company (kind, then name).
import InterviewLayout from '../../components/interviews/InterviewLayout.astro';
import CompanyCard from '../../components/interviews/CompanyCard.astro';
import PolicyMap from '../../components/interviews/PolicyMap.astro';
import { loadInterviewData, sortCompanies } from '../../lib/interviews/data';
import { label } from '../../lib/interviews/taxonomy';

const d = await loadInterviewData();
const companies = sortCompanies(d.companies);
const groups: { kind: string; items: typeof companies }[] = [];
for (const c of companies) {
  const last = groups.at(-1);
  if (last && last.kind === c.data.kind) last.items.push(c);
  else groups.push({ kind: c.data.kind, items: [c] });
}
---
<InterviewLayout
  title="Company loops"
  description="How each company's Senior and Staff AI loop is reported to run, and whether you may use AI tools in it. Every claim is dated and sourced."
  wide
>
  <p>
    These are reported loops, not official processes: most come from candidate accounts and prep sites, and
    companies change their loops often. Each card shows its confidence, sources and the date it was last checked.
  </p>

  <h2 id="ai-tool-policy">AI-tool policy at a glance</h2>
  <PolicyMap />

  <h2 id="loops">Loops by company</h2>
  {groups.map((g) => (
    <section class="cgroup" aria-labelledby={`kind-${g.kind}`}>
      <h3 id={`kind-${g.kind}`} class="cgroup-title">{label.companyKind(g.kind)} <span class="cgroup-count">{g.items.length}</span></h3>
      {g.items.map((c) => <CompanyCard company={c} />)}
    </section>
  ))}
</InterviewLayout>

<style>
.cgroup + .cgroup { margin-top: 1.75rem; }
.cgroup-title { display: flex; align-items: baseline; gap: 0.5rem; }
.cgroup-count { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; font-weight: 500; color: var(--ink-4); }
</style>
