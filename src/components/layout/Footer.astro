---
import { url } from '../../lib/interviews/url';
---
<footer class="site-footer">
  <div class="footer-inner">
    <span class="footer-copy">
      <a href="https://pushkarkumar-dev.github.io" target="_blank" rel="noopener">pushkar.dev</a>
      &nbsp;·&nbsp; 60 labs, every one runnable
    </span>
    <nav class="footer-links" aria-label="Footer">
      <a href={url('interviews')}>AI Interviews</a>
      <a href="https://github.com/pushkarkumar-dev/system-design-labs" target="_blank" rel="noopener">GitHub</a>
      <a href="https://pushkarkumar-dev.github.io/system-design" target="_blank" rel="noopener">System Design</a>
    </nav>
  </div>
</footer>

<style>
.site-footer {
  border-top: 1px solid var(--line);
  margin-top: 5rem;
}
.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}
/* --ink-4 text was 1.8:1 on the page background; --ink-3 is 4:1 in the dark theme. */
.footer-copy { font-size: 0.82rem; color: var(--ink-3); }
.footer-copy a { color: var(--ink-2); }
.footer-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
.footer-links a { font-size: 0.82rem; color: var(--ink-3); text-decoration: none; transition: color var(--dur-fast); }
.footer-links a:hover { color: var(--ink-2); }
@media (prefers-reduced-motion: reduce) {
  .footer-links a { transition: none; }
}
</style>
