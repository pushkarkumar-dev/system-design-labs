---
import { url, normalizePath } from '../../lib/interviews/url';

const here = normalizePath(Astro.url.pathname);
const home = url();
const interviewsHref = url('interviews');
const interviewsCurrent = here === interviewsHref ? 'page' : here.startsWith(interviewsHref) ? 'true' : undefined;
---
<header class="site-header">
  <div class="header-inner">
    <a href={home} class="wordmark">
      <span class="wordmark-primary">build</span><span class="wordmark-accent">.</span><span class="wordmark-secondary">labs</span>
    </a>
    <nav class="header-nav" aria-label="Site">
      <a href="https://pushkarkumar-dev.github.io" class="nav-back" target="_blank" rel="noopener">
        <span class="nav-arrow" aria-hidden="true">← </span>pushkar.dev
      </a>
      <a href="https://pushkarkumar-dev.github.io/system-design" class="nav-link" target="_blank" rel="noopener">
        System Design
      </a>
      <a href={`${home}#labs`} class="nav-link">Labs</a>
      <a href={interviewsHref} class="nav-link" aria-current={interviewsCurrent}>AI Interviews</a>
    </nav>
    <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme" title="Toggle theme">
      <span class="theme-icon-sun">☀</span>
      <span class="theme-icon-moon">☽</span>
    </button>
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  /* Follows the theme: --bg is redefined under [data-theme='light']. */
  background: var(--bg);
  background: color-mix(in srgb, var(--bg) 85%, transparent);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--line);
}
.header-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 56px;
  display: flex;
  align-items: center;
  gap: 1.5rem;
}
.wordmark {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1rem;
  font-weight: 500;
  text-decoration: none;
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}
.wordmark-primary  { color: var(--ink); }
.wordmark-accent   { color: var(--accent); font-size: 1.2rem; }
.wordmark-secondary{ color: var(--ink-3); }

.header-nav {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-left: auto;
  min-width: 0;
}
.nav-back {
  font-size: 0.8rem;
  color: var(--ink-3);
  text-decoration: none;
  border: 1px solid var(--line-2);
  border-radius: 999px;
  padding: 0.25rem 0.75rem;
  white-space: nowrap;
  transition: color var(--dur-fast), border-color var(--dur-fast);
}
.nav-back:hover { color: var(--ink); border-color: var(--accent-line); text-decoration: none; }
.nav-link {
  font-size: 0.85rem;
  color: var(--ink-3);
  text-decoration: none;
  white-space: nowrap;
  transition: color var(--dur-fast);
}
.nav-link:hover { color: var(--ink); text-decoration: none; }
.nav-link[aria-current] { color: var(--accent-ink, var(--accent)); }

.theme-btn {
  background: none;
  border: 1px solid var(--line-2);
  border-radius: var(--r-sm);
  color: var(--ink-3);
  cursor: pointer;
  padding: 0.3rem 0.5rem;
  font-size: 0.9rem;
  flex: 0 0 auto;
  transition: color var(--dur-fast), border-color var(--dur-fast);
}
.theme-btn:hover { color: var(--ink); border-color: var(--accent-line); }
html:not([data-theme='light']) .theme-icon-sun { display: none; }
html[data-theme='light']       .theme-icon-moon { display: none; }

@media (max-width: 760px) {
  .header-inner { gap: 1rem; padding: 0 1rem; }
  .header-nav { gap: 0.9rem; }
}

/* Phones: wordmark + theme button on the first row, links on a second row that
   scrolls sideways if it ever runs out of room (it never widens the page). */
@media (max-width: 600px) {
  .header-inner {
    height: auto;
    flex-wrap: wrap;
    row-gap: 0;
    padding: 0.35rem 1rem 0;
  }
  .wordmark { order: 1; height: 40px; }
  .theme-btn { order: 2; margin-left: auto; }
  .header-nav {
    order: 3;
    flex: 1 0 100%;
    max-width: 100%;
    margin-left: 0;
    gap: 0.875rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    padding: 0.15rem 0 0.6rem;
  }
  .header-nav::-webkit-scrollbar { display: none; }
  .header-nav > a { flex: 0 0 auto; }
  .nav-link { font-size: 0.82rem; }
  .nav-back { order: 9; font-size: 0.75rem; padding: 0.12rem 0.6rem; }
  .nav-arrow { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .nav-back, .nav-link, .theme-btn { transition: none; }
}
</style>

<script is:inline>
document.getElementById('theme-toggle')?.addEventListener('click', () => {
  const html = document.documentElement;
  const next = html.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
  html.setAttribute('data-theme', next);
  localStorage.setItem('theme', next);
});
</script>
