---
// Base callout used by AINative and Pitfall. Not in the MDX map on its own.
interface Props {
  variant: 'ainative' | 'pitfall' | 'note';
  label: string;
  title?: string;
}
const { variant, label, title } = Astro.props;
---
<aside class={`callout callout--${variant}`} aria-label={title ? `${label}: ${title}` : label}>
  <p class="callout-label">{label}{title && <span class="callout-title"> · {title}</span>}</p>
  <div class="callout-body"><slot /></div>
</aside>

<style>
.callout {
  --c: var(--accent);
  margin: 1.5rem 0;
  padding: 0.85rem 1.1rem;
  border: 1px solid color-mix(in srgb, var(--c) 30%, transparent);
  border-left: 3px solid var(--c);
  border-radius: var(--r-sm);
  background: color-mix(in srgb, var(--c) 6%, var(--bg-card));
}
.callout--pitfall { --c: var(--diff-extreme); }
.callout--note { --c: var(--ink-3); }
.callout-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: color-mix(in srgb, var(--c) 75%, var(--ink));
  margin: 0 0 0.35rem;
}
.callout-title { text-transform: none; letter-spacing: 0; color: var(--ink-2); }
.callout-body { font-size: 0.93rem; color: var(--ink-2); }
.callout-body :global(p:last-child),
.callout-body :global(ul:last-child),
.callout-body :global(ol:last-child) { margin-bottom: 0; }
</style>
