---
// Page shell for every /interviews/ page: BaseLayout + Header + sub-nav + hero + body + Footer.
// Runs the data integrity check, so a broken reference fails the build on any interview page.
//   <InterviewLayout title="AI Infra Engineer" description="…" researchedAt="2026-10-11" toc={headings}>
//     <Fragment slot="meta">…extra hero content…</Fragment>
//     …body…
//   </InterviewLayout>
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../layout/Header.astro';
import Footer from '../layout/Footer.astro';
import InterviewSubNav from './InterviewSubNav.astro';
import { assertInterviewIntegrity } from '../../lib/interviews/integrity';
import { loadInterviewData, latestResearchDate, formatDate } from '../../lib/interviews/data';
import { url } from '../../lib/interviews/url';

interface TocItem { slug: string; text: string }
interface Props {
  title: string;
  description: string;
  /** Date the content was researched. Defaults to the latest date in the interview data. */
  researchedAt?: string;
  updatedAt?: string;
  /** Small label above the title. */
  eyebrow?: string;
  /** Wider body for lists and tables (questions, companies). */
  wide?: boolean;
  /** H2 headings for a sticky table of contents. */
  toc?: TocItem[];
  /** Shorter text for the browser tab / <title> when `title` is long (question pages). */
  docTitle?: string;
  /** Smaller H1, for long titles such as a question prompt. */
  compactTitle?: boolean;
}
const {
  title, description, researchedAt, updatedAt, eyebrow = 'AI Interviews', wide = false, toc = [], docTitle: shortTitle,
  compactTitle = false,
} = Astro.props;

await assertInterviewIntegrity();
const data = await loadInterviewData();
const researched = researchedAt ?? latestResearchDate(data);
const isHub = Astro.url.pathname.replace(/\/$/, '') === url('interviews').replace(/\/$/, '');
const tabTitle = shortTitle ?? title;
const docTitle = isHub ? `${tabTitle} — build.labs` : `${tabTitle} — AI Interviews — build.labs`;
const hasToc = toc.length > 0;
---
<BaseLayout title={docTitle} description={description}>
  <Header />
  <InterviewSubNav />

  <main class="iv">
    <header class="iv-hero">
      <p class="iv-eyebrow">
        {isHub ? eyebrow : <a href={url('interviews')}>{eyebrow}</a>}
      </p>
      <h1 class={`iv-title${compactTitle ? ' iv-title--compact' : ''}`}>{title}</h1>
      <p class="iv-desc">{description}</p>
      {researched && (
        <p class="iv-dates">
          Researched <time datetime={researched}>{formatDate(researched)}</time>
          {updatedAt && updatedAt !== researched && <> · updated <time datetime={updatedAt}>{formatDate(updatedAt)}</time></>}
        </p>
      )}
      <slot name="meta" />
    </header>

    <div class={`iv-body${hasToc ? ' iv-body--toc' : ''}`}>
      {hasToc && (
        <aside class="iv-toc" aria-label="On this page">
          <div class="iv-toc-inner">
            <p class="iv-toc-label">On this page</p>
            <ul class="iv-toc-list">
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ul>
            <slot name="aside" />
          </div>
        </aside>
      )}
      <div class={`iv-content prose${wide ? ' iv-content--wide' : ''}`}>
        {hasToc && (
          <details class="iv-toc-mobile">
            <summary>On this page</summary>
            <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
          </details>
        )}
        <slot />
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
.iv { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
/* Divider spans the page like the lab pages; the text stays at a readable width. */
.iv-hero { padding: 2.5rem 0 1.75rem; border-bottom: 1px solid var(--line); overflow-wrap: break-word; }
.iv-hero > * { max-width: 780px; }
.iv-eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.74rem;
  color: var(--accent);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0 0 0.75rem;
}
.iv-eyebrow a { color: inherit; text-decoration: none; }
.iv-eyebrow a:hover { text-decoration: underline; }
.iv-title {
  font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  font-weight: 700;
  line-height: 1.22;
  margin: 0 0 0.75rem;
  overflow-wrap: break-word;
}
.iv-title--compact { font-size: clamp(1.2rem, 2.4vw, 1.55rem); line-height: 1.4; font-weight: 600; }
.iv-desc { font-size: 1rem; color: var(--ink-3); line-height: 1.65; max-width: 68ch; margin: 0 0 0.9rem; }
.iv-dates { font-family: 'JetBrains Mono', monospace; font-size: 0.74rem; color: var(--ink-3); margin: 0; }

.iv-body { padding: 2rem 0 0; }
.iv-body--toc {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 3rem;
  align-items: start;
}
/* Long URLs and inline code break instead of widening the page on phones. Tables
   and code blocks scroll inside their own box (TableScroll, pre). */
.iv-content { min-width: 0; overflow-wrap: break-word; }
.iv-content--wide { max-width: 980px; }
.iv-content :global(pre.astro-code) {
  padding: 0.9rem 1rem;
  border: 1px solid var(--line);
  line-height: 1.6;
  tab-size: 4;
  overflow-wrap: normal;
}
.iv-content :global(pre.astro-code:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
.iv-content :global(td),
.iv-content :global(th) { vertical-align: top; }

.iv-toc { position: sticky; top: 76px; }
.iv-toc-inner {
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  padding: 1rem;
  max-height: calc(100vh - 96px);
  overflow-y: auto;
}
.iv-toc-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin: 0 0 0.75rem;
}
.iv-toc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
.iv-toc-list a {
  display: block;
  font-size: 0.8rem;
  line-height: 1.4;
  padding: 0.15rem 0;
  color: var(--ink-3);
  text-decoration: none;
}
.iv-toc-list a:hover { color: var(--accent); }

.iv-toc-mobile { display: none; }

@media (max-width: 860px) {
  .iv-body--toc { grid-template-columns: minmax(0, 1fr); gap: 0; }
  .iv-toc { display: none; }
  .iv-toc-mobile {
    display: block;
    margin: 0 0 1.5rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--bg-card);
    padding: 0.55rem 0.85rem;
    font-size: 0.86rem;
  }
  .iv-toc-mobile summary { cursor: pointer; color: var(--ink-3); }
  .iv-toc-mobile ul { margin: 0.5rem 0 0.25rem; padding-left: 1.1rem; }
  .iv-toc-mobile li { margin: 0 0 0.25rem; }
}
@media (max-width: 600px) {
  .iv { padding: 0 1rem; }
  .iv-hero { padding: 1.75rem 0 1.25rem; }
}

/* Anchors land below the sticky header. */
.iv-content :global(h2[id]),
.iv-content :global(h3[id]) { scroll-margin-top: 6.5rem; }
</style>
