---
// Wrapper for a hand-drawn inline SVG with a caption. Theme-safe: draw with
// currentColor and the CSS variables below, never hard-coded hex colours.
//   <Figure caption="Requests queue per GPU; the batcher flushes on size or deadline.">
//     <svg viewBox="0 0 400 120" role="img" aria-label="…">
//       <rect x="10" y="10" width="80" height="40" fill="none" stroke="currentColor" />
//       <text x="50" y="35" text-anchor="middle" fill="var(--fig-accent)">batcher</text>
//     </svg>
//   </Figure>
// Variables available inside: --fig-ink, --fig-muted, --fig-line, --fig-accent, --fig-bg, --fig-warn.
interface Props {
  caption: string;
  /** Let the figure use the full content width on wide pages (default false). */
  wide?: boolean;
}
const { caption, wide = false } = Astro.props;
if (!caption) throw new Error(`[interviews] <Figure> on ${Astro.url.pathname}: caption is required.`);

// On phones a 700-unit-wide drawing squeezed into ~310px renders 11px labels at ~5px.
// Keep the drawing at ≥85% of its viewBox width there and let the frame scroll sideways.
const art = await Astro.slots.render('default');
const vb = art.match(/viewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)/i);
const minW = vb ? Math.round(parseFloat(vb[1]) * 0.85) : 0;
const scrolls = minW > 340;
---
<figure class={`fig${wide ? ' fig--wide' : ''}`}>
  <div class="fig-art" style={minW ? `--fig-minw: ${minW}px` : undefined}><Fragment set:html={art} /></div>
  <figcaption class="fig-cap">{caption}{scrolls && <span class="fig-hint"> Scroll the drawing sideways to see all of it.</span>}</figcaption>
</figure>

<style>
.fig {
  --fig-ink: var(--ink);
  --fig-muted: var(--ink-3);
  --fig-line: var(--line-2);
  --fig-accent: var(--accent);
  --fig-bg: var(--bg-card);
  --fig-warn: var(--diff-extreme);
  margin: 1.5rem 0;
}
.fig-art {
  color: var(--fig-ink);
  background: var(--fig-bg);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  padding: 1rem;
  overflow-x: auto;
}
/* Defaults are set on the <svg> and inherited, so a font-size or fill attribute the
   author put on a <text> still wins (a rule on `svg text` would override it). */
.fig-art :global(svg) {
  display: block;
  width: 100%;
  height: auto;
  max-width: 100%;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  fill: currentColor;
}
.fig-cap { margin-top: 0.5rem; font-size: 0.82rem; color: var(--ink-3); }
.fig-hint { display: none; }
@media (max-width: 640px) {
  .fig-art { padding: 0.75rem; }
  .fig-art :global(svg) { min-width: var(--fig-minw, 0px); max-width: none; }
  .fig-hint { display: inline; }
}
</style>
