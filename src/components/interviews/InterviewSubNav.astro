---
// Tab strip for the AI Interviews section. No JS; scrolls sideways on narrow screens.
import { url, normalizePath } from '../../lib/interviews/url';

const TABS = [
  { label: 'Overview', path: 'interviews' },
  { label: 'AI Engineer', path: 'interviews/ai-engineer' },
  { label: 'AI Infra', path: 'interviews/ai-infra' },
  { label: 'Walkthroughs', path: 'interviews/walkthroughs', section: true },
  { label: 'Questions', path: 'interviews/questions', section: true },
  { label: 'Companies', path: 'interviews/companies' },
  { label: 'AI-Native', path: 'interviews/ai-native' },
  { label: 'Transition', path: 'interviews/transition' },
];
const here = normalizePath(Astro.url.pathname);
const tabs = TABS.map((t) => {
  const href = url(t.path);
  const exact = here === href;
  const within = !exact && t.section && here.startsWith(href);
  return { ...t, href, current: exact ? 'page' : within ? 'true' : undefined };
});
---
<nav class="subnav" aria-label="AI Interviews sections">
  <ul class="subnav-list" id="iv-subnav-list">
    {tabs.map((t) => (
      <li><a class="subnav-tab" href={t.href} aria-current={t.current}>{t.label}</a></li>
    ))}
  </ul>
</nav>
<script is:inline>
  // On phones the strip scrolls sideways; bring the current tab into view (no animation).
  (function () {
    var list = document.getElementById('iv-subnav-list');
    var cur = list && list.querySelector('[aria-current]');
    if (!cur || list.scrollWidth <= list.clientWidth) return;
    var li = cur.parentElement;
    list.scrollLeft = Math.max(0, li.offsetLeft - (list.clientWidth - li.offsetWidth) / 2);
  })();
</script>

<style>
.subnav {
  border-bottom: 1px solid var(--line);
  background: var(--bg);
}
.subnav-list {
  position: relative; /* offsetLeft of the tabs is measured against the list */
  list-style: none;
  margin: 0 auto;
  padding: 0 1.5rem;
  max-width: 1200px;
  display: flex;
  gap: 0.25rem;
  overflow-x: auto;
  overscroll-behavior-x: contain;
  scrollbar-width: thin;
  -webkit-overflow-scrolling: touch;
}
.subnav-list li { flex: 0 0 auto; }
.subnav-tab {
  display: block;
  padding: 0.7rem 0.75rem 0.6rem;
  font-size: 0.84rem;
  color: var(--ink-3);
  text-decoration: none;
  white-space: nowrap;
  border-bottom: 2px solid transparent;
  transition: color var(--dur-fast), border-color var(--dur-fast);
}
.subnav-tab:hover { color: var(--ink); text-decoration: none; }
.subnav-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: var(--r-sm); }
.subnav-tab[aria-current] { color: var(--accent); border-bottom-color: var(--accent); }
@media (max-width: 600px) {
  /* Fade both edges so a cut-off tab reads as "more this way". */
  .subnav-list {
    padding: 0 1.25rem 0 0.75rem;
    gap: 0;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 0.75rem, #000 calc(100% - 1.75rem), transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 0.75rem, #000 calc(100% - 1.75rem), transparent 100%);
  }
  .subnav-list::-webkit-scrollbar { display: none; }
  .subnav-tab { padding: 0.6rem 0.6rem 0.5rem; font-size: 0.8rem; }
}
@media (prefers-reduced-motion: reduce) {
  .subnav-tab { transition: none; }
}
</style>
