---
// The questions a family walkthrough answers (its basedOn), each linking to its own
// question page, with companies and whether its answer card is out.
//   <FamilyQuestions w={walkthrough} />                         section + H2 (walkthrough page, before Sources)
//   <FamilyQuestions w={walkthrough} exclude="infra-001" bare /> list only (question page "Family" box)
// Not in the MDX map: pages render it.
import type { Walkthrough } from '../../lib/interviews/data';
import { companyNames, formatDate, loadInterviewData, visibleAnswer } from '../../lib/interviews/data';
import { links } from '../../lib/interviews/url';

interface Props {
  w: Walkthrough;
  /** Leave this question out (the page you're on). */
  exclude?: string;
  /** Just the list: no section, heading or intro. */
  bare?: boolean;
}
const { w, exclude, bare = false } = Astro.props;
const d = await loadInterviewData();
const rows = w.data.basedOn
  .map((r) => d.questionById.get(r.id))
  .filter((q): q is NonNullable<typeof q> => !!q && q.id !== exclude)
  .map((q) => {
    const names = companyNames(q);
    return {
      q,
      card: visibleAnswer(d, q.id),
      companies: q.data.companies.map((c, i) => ({ id: c, name: names[i], hasCard: d.companyById.has(c) })),
    };
  });
const answered = rows.filter((r) => r.card).length;
const Wrap = bare ? 'div' : 'section';
---
<Wrap class={bare ? 'famq famq--bare' : 'famq'} aria-labelledby={bare ? undefined : 'questions-in-this-family'}>
  {!bare && (
    <>
      <h2 id="questions-in-this-family">Questions in this family</h2>
      <p class="famq-intro">
        {rows.length} reported question{rows.length === 1 ? '' : 's'} share this underlying problem.
        {answered > 0 ? ` ${answered} ha${answered === 1 ? 's' : 've'} an answer card.` : ' Their answer cards are being written.'}
        Each one links to its own page with sources and confidence.
      </p>
    </>
  )}
  <ul class="famq-list">
    {rows.map(({ q, companies, card }) => (
      <li class="famq-item">
        <a class="famq-prompt" href={links.questionPage(q.id)}>{q.data.prompt}</a>
        <span class="famq-meta">
          <span class="famq-id">{q.id}</span>
          <span>{companies.map((c, i) => <>{i > 0 && ', '}{c.hasCard ? <a href={links.company(c.id)}>{c.name}</a> : c.name}</>)}</span>
          <span>{formatDate(q.data.reportedAt)}</span>
          {card
            ? <span class="famq-ans">{card.data.status === 'draft' ? 'Answer (draft)' : 'Answer'}</span>
            : <span class="famq-none">Answer coming</span>}
        </span>
      </li>
    ))}
  </ul>
</Wrap>

<style>
.famq { margin: 2.5rem 0 0; }
.famq--bare { margin: 0; }
.famq-intro { color: var(--ink-3); font-size: 0.9rem; }
.famq-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; gap: 0.65rem; }
.famq--bare .famq-list { margin: 0; }
.famq-item {
  margin: 0;
  padding: 0.6rem 0.8rem;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  background: var(--bg-card);
  line-height: 1.5;
}
.famq-prompt { display: block; color: var(--ink); font-size: 0.92rem; text-decoration: none; }
.famq-prompt:hover { color: var(--accent); text-decoration: underline; }
.famq-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.15rem 0.75rem;
  margin-top: 0.3rem;
  font-size: 0.76rem;
  color: var(--ink-3);
}
.famq-meta a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--line-2); }
.famq-meta a:hover { color: var(--accent); }
.famq-id { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; }
.famq-ans { color: var(--accent); font-weight: 600; }
.famq-none { color: var(--ink-4); }
</style>
