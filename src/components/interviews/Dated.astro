---
// A time-sensitive claim with its date and source(s).
//   <Dated asOf="2025-10" src="s-810bf5f1ff">Meta added an AI-enabled coding round</Dated>
// Renders: claim (as of Oct 2025 · Hello Interview)
import { loadInterviewData, formatDate } from '../../lib/interviews/data';

interface Props {
  asOf: string;
  src: string | string[];
}
const { asOf, src } = Astro.props;
const where = `<Dated asOf="${asOf}"> on ${Astro.url.pathname}`;
if (!/^\d{4}(-\d{2}(-\d{2})?)?$/.test(String(asOf ?? ''))) {
  throw new Error(`[interviews] ${where}: asOf must be YYYY, YYYY-MM or YYYY-MM-DD.`);
}
const ids = (Array.isArray(src) ? src : [src]).filter(Boolean);
if (!ids.length) throw new Error(`[interviews] ${where}: src (a source id) is required.`);
const { sourceById } = await loadInterviewData();
const sources = ids.map((id) => {
  const s = sourceById.get(id);
  if (!s) throw new Error(`[interviews] ${where}: no source "${id}" in src/content/interviews/sources.yaml.`);
  return s;
});
---
<span class="dated"><slot /> <span class="dated-meta">(as of <time datetime={asOf}>{formatDate(asOf)}</time>{sources.map((s) => (
  <> · <a href={s.data.url} target="_blank" rel="noopener" title={s.data.title}>{s.data.publisher}</a></>
))})</span></span>

<style>
.dated-meta {
  font-size: 0.82em;
  color: var(--ink-3);
  white-space: normal;
}
.dated-meta time { font-family: 'JetBrains Mono', monospace; font-size: 0.95em; }
.dated-meta a { color: var(--ink-3); border-bottom: 1px dotted var(--line-2); text-decoration: none; }
.dated-meta a:hover { color: var(--accent); }
</style>
