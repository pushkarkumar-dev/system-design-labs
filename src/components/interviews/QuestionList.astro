---
// Server-rendered list of QuestionRows, grouped by theme in rank order.
//   <QuestionList track="ai-infra" featured />
//   <QuestionList theme="rag" limit={5} />
// `track="ai-infra"` also includes questions whose track is "both".
// `bank` is for the question-bank page only (row anchors + filter tokens).
import { loadInterviewData, sortQuestions } from '../../lib/interviews/data';
import { label } from '../../lib/interviews/taxonomy';
import { links } from '../../lib/interviews/url';
import QuestionRow from './QuestionRow.astro';

interface Props {
  track?: 'ai-engineer' | 'ai-infra' | 'both';
  theme?: string;
  featured?: boolean;
  limit?: number;
  /** Group rows under theme headings (default true). */
  group?: boolean;
  /** Heading level for theme headings (default 3, since lists sit inside guide sections). */
  level?: 2 | 3 | 4;
  bank?: boolean;
  /** Prefix for theme-heading ids, to keep ids unique when a page has several lists. */
  idPrefix?: string;
}
const {
  track, theme, featured = false, limit, group = true, level = 3, bank = false, idPrefix,
} = Astro.props;
const { questions } = await loadInterviewData();

let rows = questions.filter((q) =>
  (!track || q.data.track === track || (track !== 'both' && q.data.track === 'both')) &&
  (!theme || q.data.theme === theme) &&
  (!featured || q.data.featured));
rows = sortQuestions(rows, track);
if (limit && limit > 0) rows = rows.slice(0, limit);

if (!rows.length) {
  console.warn(`[interviews] <QuestionList${track ? ` track="${track}"` : ''}${theme ? ` theme="${theme}"` : ''}${featured ? ' featured' : ''}> on ${Astro.url.pathname} matched no questions.`);
}

const groups: { theme: string; rows: typeof rows }[] = [];
for (const q of rows) {
  const last = groups.at(-1);
  if (group && last && last.theme === q.data.theme) last.rows.push(q);
  else if (group) groups.push({ theme: q.data.theme, rows: [q] });
  else if (last) last.rows.push(q);
  else groups.push({ theme: '', rows: [q] });
}
const prefix = idPrefix ?? (bank ? 'theme' : `ql-${track ?? 'all'}${featured ? '-featured' : ''}`);
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---
<div class="qlist" data-qlist>
  {rows.length === 0 && <p class="qlist-empty">No questions match yet.</p>}
  {groups.map((g) => (
    <section class="qgroup" data-filter-section={bank ? '' : undefined}>
      {group && (
        <H class="qgroup-title" id={`${prefix}-${g.theme}`}>
          {label.theme(g.theme)} <span class="qgroup-count" data-section-count={bank ? '' : undefined}>{g.rows.length}</span>
        </H>
      )}
      {g.rows.map((q) => <QuestionRow q={q} bank={bank} hideTheme={group} />)}
    </section>
  ))}
  {!bank && rows.length > 0 && (
    <p class="qlist-more"><a href={links.questions()}>All questions in the bank →</a></p>
  )}
</div>

<style>
.qlist { margin: 1.25rem 0; }
.qgroup + .qgroup { margin-top: 1.5rem; }
.qgroup-title {
  font-size: 1.05rem;
  margin: 0 0 0.6rem;
  color: var(--ink);
  display: flex;
  align-items: baseline;
  gap: 0.5rem;
  scroll-margin-top: 7rem;
}
.qgroup-count {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  font-weight: 500;
  color: var(--ink-4);
}
.qlist-empty, .qlist-more { font-size: 0.86rem; color: var(--ink-3); }
.qlist-more { margin-top: 0.5rem; }
</style>
