---
// `h2` override used only by walkthroughs/[id].astro (passed in its components map).
// - Puts the "Questions in this family" section right before "## Sources".
// - Drops the "## My take" heading when the page hides a pending take (production).
// The page puts a WalkthroughCtx in Astro.locals before rendering the MDX.
import FamilyQuestions from './FamilyQuestions.astro';
import { WALKTHROUGH_CTX, type WalkthroughCtx } from '../../lib/interviews/data';

const ctx = (Astro.locals as Record<string, unknown>)[WALKTHROUGH_CTX] as WalkthroughCtx | undefined;
const { id } = Astro.props as { id?: string };
const hide = Boolean(ctx?.hideMyTake && id === 'my-take');
const family = ctx && id === 'sources' ? ctx.w : undefined;
---
{family && <FamilyQuestions w={family} />}
{!hide && <h2 {...Astro.props}><slot /></h2>}
