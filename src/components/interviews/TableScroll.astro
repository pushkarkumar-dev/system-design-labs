---
// Replaces <table> in interview MDX (via the component map) so wide tables scroll
// sideways on mobile instead of widening the page.
const props = Astro.props;
---
<div class="table-scroll" role="region" aria-label="Table (scrolls sideways)" tabindex="0">
  <table {...props}><slot /></table>
</div>

<style>
.table-scroll {
  overflow-x: auto;
  margin: 1.25rem 0;
  max-width: 100%;
}
.table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.table-scroll > table { margin: 0; }
</style>
