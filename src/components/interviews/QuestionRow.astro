---
// One reported interview question.
//   <QuestionRow id="eng-001" />            (or q={entry})
// In the bank (`bank` prop) the row carries id="q-<id>" plus data-* tokens for the
// chip filter; elsewhere its id links to the question's own page.
// "Answer →" appears when the question has an answer card visible in this build; the
// walkthrough link goes to the question's family walkthrough (see familyOf in data.ts).
import type { Question } from '../../lib/interviews/data';
import { loadInterviewData, formatDate, familyOf, visibleAnswer } from '../../lib/interviews/data';
import { label } from '../../lib/interviews/taxonomy';
import { links } from '../../lib/interviews/url';
import SourceTag from './SourceTag.astro';

interface Props {
  q?: Question;
  id?: string;
  bank?: boolean;
  /** Hide the theme chip (when rows are already grouped under a theme heading). */
  hideTheme?: boolean;
}
const { q: qProp, id, bank = false, hideTheme = false } = Astro.props;
const d = await loadInterviewData();
const q = qProp ?? (id ? d.questionById.get(id) : undefined);
if (!q) throw new Error(`[interviews] <QuestionRow id="${id}"> on ${Astro.url.pathname}: no such question in src/content/interviews/questions.yaml.`);
const { data } = q;

const companies = data.companies.map((c) => ({
  id: c,
  name: c === 'other' && data.companyOther ? data.companyOther : label.company(c),
  hasCard: d.companyById.has(c),
}));
const sources = data.sources.map((r) => d.sourceById.get(r.id)).filter((s) => !!s);
const labs = data.labs.map((r) => d.labById.get(r.id)).filter((l) => !!l);
const card = visibleAnswer(d, q.id);
const walkthrough = familyOf(d, q.id);

const trackTokens = data.track === 'both' ? 'both ai-engineer ai-infra' : data.track;
const srcTypes = [...new Set(sources.map((s) => s.data.type))];
const search = [
  q.id, data.prompt, data.staffSignal ?? '', label.theme(data.theme),
  ...companies.map((c) => c.name), ...data.rounds.map(label.round), ...labs.map((l) => l.data.title),
].join(' ').toLowerCase();
const filterAttrs = bank ? {
  'data-filter-item': '',
  'data-track': trackTokens,
  'data-theme': data.theme,
  'data-round': data.rounds.join(' '),
  'data-company': data.companies.join(' '),
  'data-src': srcTypes.join(' '),
  'data-conf': data.confidence,
  'data-search': search,
} : {};
const selfHref = bank ? `#q-${q.id}` : links.questionPage(q.id);
---
<article class={`qrow${data.featured ? ' qrow--featured' : ''}`} id={bank ? `q-${q.id}` : undefined} {...filterAttrs}>
  <header class="qrow-head">
    <a class="qrow-id" href={selfHref} title={bank ? 'Link to this question' : 'Open the question page'}>{q.id}</a>
    <span class="qrow-companies">
      {companies.map((c, i) => (
        <>{i > 0 && ', '}{c.hasCard ? <a href={links.company(c.id)}>{c.name}</a> : <span>{c.name}</span>}</>
      ))}
    </span>
    <span class="qrow-dot" aria-hidden="true">·</span>
    <span class="qrow-date" title="When it was reported">{formatDate(data.reportedAt)}</span>
    {data.levels.length > 0 && (
      <><span class="qrow-dot" aria-hidden="true">·</span><span class="qrow-level">{data.levels.map(label.level).join(' / ')}</span></>
    )}
    {data.featured && <span class="qrow-featured">Featured</span>}
  </header>

  <p class="qrow-prompt">{data.prompt}</p>

  <div class="qrow-meta">
    {!hideTheme && <span class="qrow-chip qrow-chip--theme">{label.theme(data.theme)}</span>}
    {data.rounds.map((r) => <span class="qrow-chip">{label.round(r)}</span>)}
    <SourceTag confidence={data.confidence} />
  </div>

  {data.staffSignal && (
    <p class="qrow-staff"><span class="qrow-k">Staff signal</span> {data.staffSignal}</p>
  )}

  <div class="qrow-foot">
    <div class="qrow-line">
      <span class="qrow-k">Sources</span>
      <ul class="qrow-list">
        {sources.map((s) => (
          <li>
            <a href={s.data.url} target="_blank" rel="noopener" title={s.data.title}>{s.data.publisher}</a>
            {s.data.published && <span class="qrow-sdate">{formatDate(s.data.published)}</span>}
            <SourceTag type={s.data.type} />
          </li>
        ))}
      </ul>
    </div>
    {labs.length > 0 && (
      <div class="qrow-line">
        <span class="qrow-k">Prepare with</span>
        <ul class="qrow-list qrow-list--inline">
          {labs.map((l) => <li><a href={links.lab(l.id)}>{l.data.title}</a></li>)}
        </ul>
      </div>
    )}
    {(card || walkthrough) && (
      <div class="qrow-line qrow-line--next">
        {card && (
          <span class="qrow-next">
            <a class="qrow-answer" href={links.questionPage(q.id)}>Answer →</a>
            {card.data.status === 'draft' && <span class="qrow-draft">Draft</span>}
          </span>
        )}
        {walkthrough && (
          <span class="qrow-next">
            <span class="qrow-k">Walkthrough</span>
            <a href={links.walkthrough(walkthrough.id)}>{walkthrough.data.title}</a>
            {walkthrough.data.status === 'draft' && <span class="qrow-draft">Draft</span>}
          </span>
        )}
      </div>
    )}
  </div>
</article>

<style>
.qrow {
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-card);
  padding: 0.9rem 1rem;
  margin: 0 0 0.75rem;
  scroll-margin-top: 7rem;
  line-height: 1.55;
}
.qrow:target {
  border-color: var(--accent-line);
  box-shadow: 0 0 0 3px var(--accent-soft);
}
.qrow-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.2rem 0.45rem;
  font-size: 0.8rem;
  color: var(--ink-3);
}
.qrow-id {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  color: var(--ink-3);
  text-decoration: none;
}
.qrow-id:hover { color: var(--accent); }
.qrow-companies { color: var(--ink-2); font-weight: 600; }
.qrow-companies a { color: inherit; text-decoration: none; border-bottom: 1px dotted var(--line-2); }
.qrow-companies a:hover { color: var(--accent); }
.qrow-dot { color: var(--ink-4); }
.qrow-date, .qrow-level { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; }
.qrow-featured {
  margin-left: auto;
  font-size: 0.65rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
}
.qrow-prompt {
  margin: 0.4rem 0 0.55rem;
  color: var(--ink);
  font-size: 0.95rem;
}
.qrow-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem; margin-bottom: 0.5rem; }
.qrow-chip {
  font-size: 0.7rem;
  padding: 0.05rem 0.5rem;
  border-radius: 999px;
  border: 1px solid var(--line-2);
  color: var(--ink-3);
  white-space: nowrap;
}
.qrow-chip--theme { color: var(--ink-2); border-color: var(--accent-line); }
.qrow-staff {
  margin: 0 0 0.5rem;
  font-size: 0.86rem;
  color: var(--ink-2);
  padding-left: 0.6rem;
  border-left: 2px solid var(--accent-line);
}
.qrow-k {
  font-size: 0.64rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--ink-3);
  margin-right: 0.45rem;
  white-space: nowrap;
}
.qrow-foot { display: grid; gap: 0.3rem; font-size: 0.82rem; }
.qrow-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.4rem; }
.qrow-line a { color: var(--accent); }
.qrow-line > .qrow-list { flex: 1 1 14rem; min-width: 0; }
.qrow-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 0.9rem; }
.qrow-list li { margin: 0; display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; }
/* Lab titles flow as one line of text, so a wrapped line never starts with a separator. */
.qrow-list--inline { display: block; }
.qrow-list--inline li { display: inline; }
.qrow-list--inline li + li::before { content: '·'; color: var(--ink-4); margin: 0 0.45rem 0 0.3rem; }
.qrow-line--next { gap: 0.3rem 1.1rem; }
.qrow-next { display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 0.2rem 0.4rem; }
.qrow-answer { font-weight: 600; }
.qrow-sdate { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--ink-3); }
.qrow-draft {
  font-size: 0.64rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
  border: 1px dashed currentColor;
  border-radius: 999px;
  padding: 0 0.4rem;
}
</style>
