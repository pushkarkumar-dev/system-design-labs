---
// Source-type pill and/or confidence pill. Pass either or both.
//   <SourceTag type="first-hand" confidence="medium" />
import { label } from '../../lib/interviews/taxonomy';

interface Props {
  type?: string;
  confidence?: 'high' | 'medium' | 'low' | string;
}
const { type, confidence } = Astro.props;

const TYPE_HELP: Record<string, string> = {
  official: 'Company careers page, engineering blog, recruiter guide or policy page',
  'first-hand': "A candidate's or interviewer's own account",
  aggregator: 'Candidate-submitted question bank; only the title is treated as reported',
  secondary: 'Prep-site article or newsletter',
  news: 'News coverage',
  snippet: 'The page was blocked; only a search-result snippet was seen',
};
const CONF_HELP: Record<string, string> = {
  high: 'Backed by an official or several independent first-hand sources',
  medium: 'One first-hand account, or aggregator/secondary sources only',
  low: 'A single anonymous report, or snippets only',
};
---
<span class="tags">
  {type && (
    <span class={`pill src src--${type}`} title={TYPE_HELP[type] ?? ''}>
      {label.sourceType(type)}
    </span>
  )}
  {confidence && (
    <span class={`pill conf conf--${confidence}`} title={CONF_HELP[confidence] ?? ''}>
      {label.confidence(confidence)} confidence
    </span>
  )}
</span>

<style>
.tags { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; vertical-align: middle; }
.pill {
  --c: var(--ink-3);
  display: inline-flex;
  align-items: center;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0.02em;
  padding: 0.05rem 0.5rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
  background: color-mix(in srgb, var(--c) 10%, transparent);
  color: color-mix(in srgb, var(--c) 70%, var(--ink));
  white-space: nowrap;
}
.src--official   { --c: var(--accent); }
.src--first-hand { --c: var(--diff-intermediate); }
.src--aggregator,
.src--secondary,
.src--news       { --c: var(--ink-3); }
.src--snippet    { --c: var(--diff-extreme); border-style: dashed; }

.conf--high   { --c: var(--diff-intermediate); }
.conf--medium { --c: var(--diff-advanced); }
.conf--low    { --c: var(--diff-extreme); }
</style>
