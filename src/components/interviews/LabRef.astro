---
// Links a lab and shows what the guide may claim about it (labStatus caveat).
// Never shows benchmark numbers: use <LabNumber> for that.
//   <LabRef lab="rag" role="proof" note="Hybrid retrieval and reranking, stage by stage." />
//   <LabRef lab="llm-inference" inline />          (inline link + status pill, caveat on hover)
import { loadInterviewData } from '../../lib/interviews/data';
import { labStatus, LAB_STATUS_LABEL } from '../../lib/interviews/labStatus';
import { url } from '../../lib/interviews/url';

interface Props {
  lab?: string;
  /** Alias of `lab`. */
  slug?: string;
  role?: 'proof' | 'background' | 'partial';
  note?: string;
  inline?: boolean;
}
const { lab: labProp, slug, role, note, inline = false } = Astro.props;
const id = labProp ?? slug ?? '';
const where = `<LabRef lab="${id}"> on ${Astro.url.pathname}`;
const { labById } = await loadInterviewData();
const lab = labById.get(id);
if (!lab) throw new Error(`[interviews] ${where}: no lab "${id}" (src/content/labs/${id}.mdx doesn't exist).`);
const st = labStatus(id);
if (role === 'proof' && st.status !== 'proof') {
  throw new Error(`[interviews] ${where}: role "proof" needs a lab with status "proof", but "${id}" is "${st.status}". Use role "partial" or "background".`);
}
const ROLE_LABEL = { proof: 'Proves it', background: 'Background', partial: 'Partly covers it' } as const;
const href = url(id);
---
{inline ? (
  <span class="labref-inline"><a href={href}>{lab.data.title}</a>{st.status !== 'proof' && (
    <span class={`status status--${st.status}`} title={st.caveat}>{LAB_STATUS_LABEL[st.status]}</span>
  )}</span>
) : (
  <div class={`labref labref--${st.status}`}>
    <div class="labref-head">
      <a class="labref-title" href={href}>{lab.data.title}</a>
      {role && <span class={`role role--${role}`}>{ROLE_LABEL[role]}</span>}
      <span class={`status status--${st.status}`}>{LAB_STATUS_LABEL[st.status]}</span>
      <span class="labref-lang">{lab.data.language}</span>
    </div>
    {note && <p class="labref-note">{note}</p>}
    {st.caveat && <p class="labref-caveat">{st.caveat}</p>}
  </div>
)}

<style>
.labref {
  border: 1px solid var(--line-2);
  border-left: 3px solid var(--accent-line);
  border-radius: var(--r-sm);
  background: var(--bg-card);
  padding: 0.7rem 0.9rem;
  margin: 0.75rem 0;
}
.labref--partial,
.labref--needs-measurement { border-left-color: color-mix(in srgb, var(--diff-advanced) 60%, transparent); }
.labref--not-llm { border-left-color: color-mix(in srgb, var(--diff-extreme) 60%, transparent); }
.labref-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 0.5rem; }
.labref-title { font-weight: 600; color: var(--ink); text-decoration: none; }
.labref-title:hover { color: var(--accent); }
.labref-lang {
  margin-left: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  color: var(--ink-4);
}
.labref-note { margin: 0.35rem 0 0; font-size: 0.88rem; color: var(--ink-2); }
.labref-caveat { margin: 0.3rem 0 0; font-size: 0.8rem; color: var(--ink-3); }

.role, .status {
  --c: var(--ink-3);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.66rem;
  line-height: 1.5;
  padding: 0.02rem 0.45rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
  color: color-mix(in srgb, var(--c) 70%, var(--ink));
  background: color-mix(in srgb, var(--c) 10%, transparent);
  white-space: nowrap;
}
.role--proof { --c: var(--accent); }
.status--proof { --c: var(--diff-intermediate); }
.status--partial, .status--needs-measurement { --c: var(--diff-advanced); }
.status--not-llm { --c: var(--diff-extreme); }

.labref-inline .status { margin-left: 0.35em; vertical-align: 0.1em; }
</style>
