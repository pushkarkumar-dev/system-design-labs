---
// One company's reported loop, as a <details id="c-<id>">.
//   <CompanyCard id="anthropic" />           (or company={entry})
import type { Company } from '../../lib/interviews/data';
import { loadInterviewData, formatDate, ageInDays, STALE_AFTER_DAYS } from '../../lib/interviews/data';
import { label } from '../../lib/interviews/taxonomy';
import SourceTag from './SourceTag.astro';

interface Props {
  company?: Company;
  id?: string;
  open?: boolean;
}
const { company: cProp, id, open = false } = Astro.props;
const d = await loadInterviewData();
const c = cProp ?? (id ? d.companyById.get(id) : undefined);
if (!c) throw new Error(`[interviews] <CompanyCard id="${id}"> on ${Astro.url.pathname}: no such company in src/content/interviews/companies.yaml.`);
const { data } = c;
const policySources = data.aiToolPolicy.sources.map((r) => d.sourceById.get(r.id)).filter((s) => !!s);
const sources = data.sources.map((r) => d.sourceById.get(r.id)).filter((s) => !!s);
const questionCount = d.questions.filter((q) => q.data.companies.includes(c.id as any)).length;
const stale = ageInDays(data.lastVerified) > STALE_AFTER_DAYS;
// "Anthropic, Anthropic" reads as a duplicate: when a publisher repeats, add the date (or type).
const pubCount = new Map<string, number>();
for (const s of policySources) pubCount.set(s.data.publisher, (pubCount.get(s.data.publisher) ?? 0) + 1);
const policyNames = policySources.map((s) => pubCount.get(s.data.publisher)! > 1
  ? `${s.data.publisher} (${formatDate(s.data.published) || label.sourceType(s.data.type).toLowerCase()})`
  : s.data.publisher);
---
<details class="ccard" id={`c-${c.id}`} open={open}>
  <summary class="ccard-sum">
    <span class="ccard-name">{data.name}</span>
    <span class="ccard-pills">
      <span class="ccard-kind">{label.companyKind(data.kind)}</span>
      <span class={`ccard-policy ccard-policy--${data.aiToolPolicy.status}`}>{label.aiToolPolicy(data.aiToolPolicy.status)}</span>
      <SourceTag confidence={data.confidence} />
    </span>
  </summary>

  <div class="ccard-body">
    <p class="ccard-tracks">
      Hires for: {data.tracks.map(label.track).join(', ')}
      {questionCount > 0 && <> · {questionCount} reported question{questionCount === 1 ? '' : 's'} in the bank</>}
    </p>

    <h4 class="ccard-h">Reported loop</h4>
    <ol class="ccard-loop">
      {data.loop.map((s) => (
        <li>
          <span class="loop-stage">{s.stage}</span>
          <span class="loop-meta">{label.round(s.round)}{s.minutes ? ` · ${s.minutes} min` : ''}</span>
          {s.notes && <span class="loop-notes">{s.notes}</span>}
        </li>
      ))}
    </ol>

    <h4 class="ccard-h">AI-tool policy</h4>
    <p class="ccard-policytext">
      <strong>{label.aiToolPolicy(data.aiToolPolicy.status)}.</strong> {data.aiToolPolicy.detail}
      <span class="ccard-asof">As of {formatDate(data.aiToolPolicy.asOf)}:
        {policySources.map((s, i) => (
          <>{i > 0 && ', '}<a href={s.data.url} target="_blank" rel="noopener" title={s.data.title}>{policyNames[i]}</a></>
        ))}
      </span>
    </p>

    {data.distinctive.length > 0 && (
      <>
        <h4 class="ccard-h">What candidates report</h4>
        <ul class="ccard-list">{data.distinctive.map((x) => <li>{x}</li>)}</ul>
      </>
    )}

    <h4 class="ccard-h">Sources</h4>
    <ul class="ccard-sources">
      {sources.map((s) => (
        <li>
          <a href={s.data.url} target="_blank" rel="noopener">{s.data.title}</a>
          <span class="ccard-pub">{s.data.publisher}{s.data.published ? `, ${formatDate(s.data.published)}` : ''}</span>
          <SourceTag type={s.data.type} />
        </li>
      ))}
    </ul>

    <p class={`ccard-verified${stale ? ' ccard-verified--stale' : ''}`}>
      Last verified <time datetime={data.lastVerified}>{formatDate(data.lastVerified)}</time>{stale && ' (over 180 days ago; may be out of date)'}
    </p>
  </div>
</details>

<script>
  // Open a company card when the URL points at it (#c-<id>). Bundled once per page.
  function openTarget() {
    const id = decodeURIComponent(location.hash.slice(1));
    const el = id ? document.getElementById(id) : null;
    if (el instanceof HTMLDetailsElement) el.open = true;
  }
  window.addEventListener('hashchange', openTarget);
  openTarget();
</script>

<style>
.ccard {
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-card);
  margin: 0 0 0.75rem;
  scroll-margin-top: 7rem;
}
.ccard[open] { border-color: var(--line-2); }
.ccard:target { border-color: var(--accent-line); }
.ccard-sum {
  cursor: pointer;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.4rem 0.75rem;
  padding: 0.85rem 1rem;
}
.ccard-sum::-webkit-details-marker { display: none; }
.ccard-sum::before {
  content: '▸';
  color: var(--ink-3);
  font-size: 0.8rem;
  transition: transform var(--dur-fast);
}
.ccard[open] > .ccard-sum::before { transform: rotate(90deg); }
.ccard-sum:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-md); }
.ccard-name {
  font-family: 'Source Serif 4 Variable', Georgia, serif;
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--ink);
}
.ccard-pills { display: inline-flex; flex-wrap: wrap; gap: 0.3rem; margin-left: auto; }
.ccard-kind, .ccard-policy {
  --c: var(--ink-3);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  line-height: 1.5;
  padding: 0.05rem 0.5rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
  background: color-mix(in srgb, var(--c) 10%, transparent);
  color: color-mix(in srgb, var(--c) 70%, var(--ink));
  white-space: nowrap;
}
.ccard-policy--allowed, .ccard-policy--required-round { --c: var(--diff-intermediate); }
.ccard-policy--some-rounds, .ccard-policy--pilot, .ccard-policy--banned-except { --c: var(--diff-advanced); }
.ccard-policy--banned { --c: var(--diff-extreme); }
.ccard-body { padding: 0 1rem 1rem; border-top: 1px solid var(--line); font-size: 0.9rem; color: var(--ink-2); }
.ccard-tracks { margin: 0.75rem 0 0; font-size: 0.82rem; color: var(--ink-3); }
.ccard-h {
  font-family: inherit;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin: 1rem 0 0.4rem;
}
.ccard-loop { margin: 0; padding-left: 1.3rem; }
.ccard-loop li { margin: 0 0 0.35rem; }
.loop-stage { color: var(--ink); font-weight: 600; margin-right: 0.4rem; }
.loop-meta { display: inline-block; font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; color: var(--ink-3); }
.loop-notes { display: block; font-size: 0.84rem; color: var(--ink-2); }
.ccard-policytext { margin: 0; }
.ccard-asof { display: block; font-size: 0.8rem; color: var(--ink-3); margin-top: 0.2rem; }
.ccard-asof a, .ccard-sources a { color: var(--accent); }
.ccard-list { margin: 0; padding-left: 1.2rem; }
.ccard-list li { margin: 0 0 0.3rem; }
.ccard-sources { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
.ccard-sources li { margin: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.5rem; font-size: 0.84rem; }
.ccard-pub { color: var(--ink-3); font-size: 0.78rem; }
.ccard-verified { margin: 1rem 0 0; font-size: 0.78rem; color: var(--ink-3); font-family: 'JetBrains Mono', monospace; }
.ccard-verified--stale { color: var(--diff-extreme); }
@media (prefers-reduced-motion: reduce) {
  .ccard-sum::before { transition: none; }
}
</style>
