---
// The only way to quote a lab benchmark in the guide. Looks the row up in the lab's
// frontmatter `benchmarks` and labels it "measured on …", "calculated" or "estimated".
//   <LabNumber lab="model-quantizer" metric="INT4 weight error, one scale per 32 weights" />
// `metric` is matched exactly first, then as a unique case-insensitive substring.
// Throws if the lab or metric isn't found, or if the substring matches several rows.
import { loadInterviewData, benchmarkProvenance } from '../../lib/interviews/data';
import { url } from '../../lib/interviews/url';

interface Props {
  lab: string;
  metric: string;
  /** Also print the metric name before the value. */
  showMetric?: boolean;
}
const { lab: id, metric, showMetric = false } = Astro.props;
const where = `<LabNumber lab="${id}" metric="${metric}"> on ${Astro.url.pathname}`;
const { labById } = await loadInterviewData();
const lab = labById.get(id);
if (!lab) throw new Error(`[interviews] ${where}: no lab "${id}".`);
const rows = lab.data.benchmarks;
let row = rows.find((b) => b.metric === metric);
if (!row) {
  const hits = rows.filter((b) => b.metric.toLowerCase().includes(String(metric).toLowerCase()));
  if (hits.length === 1) row = hits[0];
  else {
    const list = rows.map((b) => `    "${b.metric}"`).join('\n');
    throw new Error(
      `[interviews] ${where}: ${hits.length ? `matches ${hits.length} rows; be more specific` : 'no such metric'}. ` +
      `Metrics in src/content/labs/${id}.mdx:\n${list}`,
    );
  }
}
const prov = benchmarkProvenance(row);
const provText = prov.kind === 'measured' ? `measured on ${prov.on}` : prov.kind;
---
<span class={`labnum labnum--${prov.kind}`} title={row.note ? `${row.metric}: ${row.note}` : row.metric}>{showMetric && <span class="labnum-metric">{row.metric}: </span>}<strong class="labnum-value">{row.value}</strong>&nbsp;<span class="labnum-unit">{row.unit}</span> <a class="labnum-prov" href={url(id)}>({provText} · {id} lab)</a></span>

<style>
.labnum { white-space: normal; }
.labnum-value { color: var(--ink); font-weight: 700; }
.labnum-unit { color: var(--ink-2); }
.labnum-metric { color: var(--ink-2); }
.labnum-prov {
  font-size: 0.8em;
  color: var(--ink-3);
  text-decoration: none;
  border-bottom: 1px dotted var(--line-2);
}
.labnum-prov:hover { color: var(--accent); }
.labnum--estimated .labnum-prov,
.labnum--calculated .labnum-prov { font-style: italic; }
.labnum--estimated .labnum-value { color: var(--ink-2); }
</style>
