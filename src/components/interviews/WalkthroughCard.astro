---
// Card for the walkthrough index.
//   <WalkthroughCard w={entry} />
import type { Walkthrough } from '../../lib/interviews/data';
import { loadInterviewData, visibleAnswer } from '../../lib/interviews/data';
import { label } from '../../lib/interviews/taxonomy';
import { links } from '../../lib/interviews/url';

interface Props { w: Walkthrough }
const { w } = Astro.props;
const { data } = w;
const d = await loadInterviewData();
const total = data.basedOn.length;
const answered = data.basedOn.filter((r) => visibleAnswer(d, r.id)).length;
const FORMAT = {
  design: 'Design', coding: 'Coding', estimation: 'Estimation', 'deep-dive': 'Deep dive', behavioral: 'Behavioral',
  narrative: 'Narrative',
} as const;
const LEVEL = { senior: 'Senior', staff: 'Staff', both: 'Senior + Staff' } as const;
const TRACK = { 'ai-engineer': 'AI Engineer', 'ai-infra': 'AI Infra', cross: 'Both tracks' } as const;
---
<a class={`wcard${data.status === 'draft' ? ' wcard--draft' : ''}`} href={links.walkthrough(w.id)}>
  <div class="wcard-top">
    {data.status === 'draft' && <span class="wcard-draft">Draft</span>}
    <span class="wcard-pill">{FORMAT[data.format]}</span>
    <span class="wcard-pill">{TRACK[data.track]}</span>
    <span class="wcard-pill">{LEVEL[data.level]}</span>
  </div>
  <h3 class="wcard-title">{data.title}</h3>
  <p class="wcard-summary">{data.summary}</p>
  <p class="wcard-meta">
    <span>{answered} of {total} question{total === 1 ? '' : 's'} answered</span>
    <span>{data.timeboxMin} min</span>
    <span>{data.rounds.map(label.round).join(' · ')}</span>
    {data.askedAt.length > 0 && <span>Reported at {data.askedAt.map(label.company).join(', ')}</span>}
  </p>
</a>

<style>
.wcard {
  display: block;
  height: 100%;
  background: var(--bg-card);
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  padding: 1.1rem 1.2rem;
  color: inherit;
  text-decoration: none;
  transition: border-color var(--dur-fast), background var(--dur-fast);
}
.wcard:hover { border-color: var(--accent-line); background: var(--bg-raised); text-decoration: none; }
.wcard:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.wcard--draft { border-style: dashed; }
.wcard-top { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.6rem; }
.wcard-pill {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  padding: 0.05rem 0.5rem;
  border-radius: 999px;
  border: 1px solid var(--line-2);
  color: var(--ink-3);
}
.wcard-draft {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.66rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink));
  border: 1px dashed currentColor;
  border-radius: 999px;
  padding: 0.02rem 0.45rem;
}
.wcard-title {
  font-size: 1.05rem;
  color: var(--ink);
  margin: 0 0 0.4rem;
  line-height: 1.35;
}
.wcard-summary { font-size: 0.86rem; color: var(--ink-3); line-height: 1.55; margin: 0 0 0.6rem; }
.wcard-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 0.9rem;
  font-size: 0.74rem;
  color: var(--ink-3);
  font-family: 'JetBrains Mono', monospace;
  margin: 0;
}
@media (prefers-reduced-motion: reduce) {
  .wcard { transition: none; }
}
</style>
