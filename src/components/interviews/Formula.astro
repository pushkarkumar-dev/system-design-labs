---
// A formula in monospace with a variable legend and a worked example. No KaTeX.
//   <Formula
//     title="KV cache per token"
//     expr="bytes/token = 2 × layers × n_kv_heads × head_dim × bytes_per_value"
//     vars={[{ sym: 'layers', meaning: 'transformer layers' }, …]}
//     example="Llama-3-70B, bf16: 2 × 80 × 8 × 128 × 2 = 327,680 B ≈ 320 KiB per token"
//   />
// `vars` and `example` are required: a formula without them is a memorized multiplier.

interface Var { sym: string; meaning: string }
interface Props {
  expr: string;
  vars: Var[];
  example: string | string[];
  title?: string;
  /** Optional caveat or source note under the example. */
  note?: string;
}
const { expr, vars, example, title, note } = Astro.props;
const where = `<Formula${title ? ` title="${title}"` : ''}> on ${Astro.url.pathname}`;
if (!expr) throw new Error(`[interviews] ${where}: expr is required.`);
if (!Array.isArray(vars) || vars.length === 0 || vars.some((v) => !v?.sym || !v?.meaning)) {
  throw new Error(`[interviews] ${where}: vars must be a non-empty list of { sym, meaning }.`);
}
const examples = (Array.isArray(example) ? example : [example]).filter(Boolean);
if (!examples.length) throw new Error(`[interviews] ${where}: example (a worked example) is required.`);
---
<figure class="formula">
  {title && <figcaption class="formula-title">{title}</figcaption>}
  <pre class="formula-expr"><code>{expr}</code></pre>
  <dl class="formula-vars">
    {vars.map((v) => (
      <div class="formula-var">
        <dt><code>{v.sym}</code></dt>
        <dd>{v.meaning}</dd>
      </div>
    ))}
  </dl>
  <div class="formula-example">
    <span class="formula-label">Worked example</span>
    {examples.map((e) => <p><code>{e}</code></p>)}
  </div>
  {note && <p class="formula-note">{note}</p>}
</figure>

<style>
.formula {
  margin: 1.5rem 0;
  background: var(--bg-card);
  border: 1px solid var(--line-2);
  border-radius: var(--r-md);
  padding: 1rem 1.15rem;
}
.formula-title {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin-bottom: 0.6rem;
}
.formula-expr {
  margin: 0 0 0.85rem;
  padding: 0.6rem 0.75rem;
  background: var(--code-bg);
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  overflow-x: auto;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.formula-expr code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.86rem;
  color: var(--accent);
  background: none;
  border: none;
  padding: 0;
}
/* One grid for the whole legend so symbols and meanings line up; the symbol column
   is capped so a long symbol wraps instead of squeezing the meanings on phones. */
.formula-vars {
  display: grid;
  grid-template-columns: fit-content(42%) minmax(0, 1fr);
  gap: 0.3rem 0.75rem;
  align-items: baseline;
  margin: 0 0 0.85rem;
  font-size: 0.86rem;
}
.formula-var { display: contents; }
.formula-var dt code { font-size: 0.8rem; color: var(--ink); overflow-wrap: anywhere; }
.formula-var dd { color: var(--ink-2); margin: 0; min-width: 0; }
.formula-example {
  border-top: 1px solid var(--line);
  padding-top: 0.7rem;
}
.formula-label {
  display: block;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin-bottom: 0.3rem;
}
.formula-example p { margin: 0 0 0.25rem; }
.formula-example code {
  font-size: 0.82rem;
  background: none;
  border: none;
  padding: 0;
  color: var(--ink);
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.formula-note { margin: 0.5rem 0 0; font-size: 0.8rem; color: var(--ink-3); }
@media (max-width: 520px) {
  .formula { padding: 0.9rem 0.9rem; }
}
</style>
