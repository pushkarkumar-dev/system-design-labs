---
// Wrapper for a list of <FollowUp> items (each a <details>). Walkthroughs need ≥5.
//   <FollowUps>
//     <FollowUp q="What if one GPU in the pool dies mid-batch?">
//       Markdown answer…
//     </FollowUp>
//   </FollowUps>
interface Props { title?: string }
const { title } = Astro.props;
---
<div class="followups">
  {title && <p class="followups-title">{title}</p>}
  <slot />
</div>

<style>
.followups { margin: 1.25rem 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
.followups-title {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin: 0;
}
</style>
