---
// Inline citation: resolves a source id from sources.yaml and links to it.
// Throws at build time if the id doesn't exist.
//   <Cite id="s-810bf5f1ff" />                 → Hello Interview · secondary · Feb 2026
//   <Cite id="s-810bf5f1ff" label="Hello Interview's write-up" />
import { loadInterviewData, formatDate } from '../../lib/interviews/data';
import { label as tx } from '../../lib/interviews/taxonomy';

interface Props {
  id: string;
  label?: string;
}
const { id, label } = Astro.props;
const { sourceById } = await loadInterviewData();
const s = sourceById.get(id);
if (!s) {
  throw new Error(`[interviews] <Cite id="${id}">: no source with that id in src/content/interviews/sources.yaml (page ${Astro.url.pathname}).`);
}
const { title, url, type, publisher, published } = s.data;
const meta = [tx.sourceType(type).toLowerCase(), formatDate(published)].filter(Boolean).join(' · ');
---
<a class={`cite cite--${type}`} href={url} target="_blank" rel="noopener" title={title}><span class="cite-pub">{label ?? publisher}</span><span class="cite-meta">{meta}</span></a>

<style>
.cite {
  display: inline;
  font-size: 0.86em;
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px dotted var(--accent-line);
  white-space: normal;
}
.cite:hover { border-bottom-style: solid; text-decoration: none; }
.cite-meta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78em;
  color: var(--ink-3);
  margin-left: 0.35em;
}
.cite--snippet .cite-meta { color: color-mix(in srgb, var(--diff-extreme) 70%, var(--ink)); }
</style>
