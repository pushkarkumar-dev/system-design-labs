---
// Table of each company's reported AI-tool policy in interviews.
//   <PolicyMap />                 (all companies)
//   <PolicyMap kind="frontier-lab" />
import { loadInterviewData, sortCompanies, formatDate } from '../../lib/interviews/data';
import { label } from '../../lib/interviews/taxonomy';
import { links } from '../../lib/interviews/url';

interface Props {
  kind?: string;
  /** Show the policy detail column (default true). */
  detail?: boolean;
}
const { kind, detail = true } = Astro.props;
const d = await loadInterviewData();
const companies = sortCompanies(d.companies.filter((c) => !kind || c.data.kind === kind));

// "Anthropic, Anthropic" reads as a duplicate: when a publisher repeats in one list,
// add the source's date (or its type) so the links can be told apart.
type Src = { data: { publisher: string; published?: string; type: string } };
function sourceLabels(list: Src[]): string[] {
  const count = new Map<string, number>();
  for (const s of list) count.set(s.data.publisher, (count.get(s.data.publisher) ?? 0) + 1);
  const out = list.map((s) => count.get(s.data.publisher)! > 1
    ? `${s.data.publisher} (${formatDate(s.data.published) || label.sourceType(s.data.type).toLowerCase()})`
    : s.data.publisher);
  return out.map((l, i) => (out.indexOf(l) !== i ? `${l} #${out.slice(0, i + 1).filter((x) => x === l).length}` : l));
}
---
<div class="policy-scroll" role="region" aria-label="AI-tool policy by company" tabindex="0">
  <!-- Explicit roles: on phones the rows are restyled as stacked blocks (display: block),
       which would otherwise drop the table semantics in some browsers. -->
  <table class="policy" role="table">
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">Company</th>
        <th scope="col" role="columnheader">AI in interviews</th>
        {detail && <th scope="col" role="columnheader">What's reported</th>}
        <th scope="col" role="columnheader">As of</th>
        <th scope="col" role="columnheader">Sources</th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {companies.map((c) => {
        const p = c.data.aiToolPolicy;
        const srcs = p.sources.map((r) => d.sourceById.get(r.id)).filter((s) => !!s);
        const names = sourceLabels(srcs);
        return (
          <tr role="row">
            <th scope="row" role="rowheader"><a href={links.company(c.id)}>{c.data.name}</a><span class="policy-kind">{label.companyKind(c.data.kind)}</span></th>
            <td role="cell" class="policy-cell-status"><span class={`policy-status policy-status--${p.status}`}>{label.aiToolPolicy(p.status)}</span></td>
            {detail && <td role="cell" class="policy-detail">{p.detail}</td>}
            <td role="cell" class="policy-date" data-label="As of"><time datetime={p.asOf}>{formatDate(p.asOf)}</time></td>
            <td role="cell" class="policy-src" data-label="Sources">
              {srcs.map((s, i) => (
                <>{i > 0 && ', '}<a href={s.data.url} target="_blank" rel="noopener" title={`${s.data.title} (${label.sourceType(s.data.type)})`}>{names[i]}</a></>
              ))}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
.policy-scroll {
  overflow-x: auto;
  margin: 1.25rem 0;
  border: 1px solid var(--line);
  border-radius: var(--r-md);
  background: var(--bg-card);
}
.policy-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.policy { width: 100%; min-width: 40rem; border-collapse: collapse; margin: 0; font-size: 0.86rem; }
.policy th, .policy td {
  text-align: left;
  vertical-align: top;
  padding: 0.55rem 0.75rem;
  border-bottom: 1px solid var(--line);
}
.policy thead th {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
  border-bottom-color: var(--line-2);
  white-space: nowrap;
}
.policy tbody tr:last-child > * { border-bottom: none; }
.policy tbody th {
  font-size: 0.86rem;
  font-weight: 600;
  text-transform: none;
  letter-spacing: normal;
  color: var(--ink);
  white-space: nowrap;
}
.policy tbody th a { color: var(--ink); text-decoration: none; }
.policy tbody th a:hover { color: var(--accent); }
.policy-kind { display: block; font-weight: 400; font-size: 0.72rem; color: var(--ink-4); }
.policy-detail { color: var(--ink-2); min-width: 16rem; }
.policy-date { font-family: 'JetBrains Mono', monospace; font-size: 0.75rem; color: var(--ink-3); white-space: nowrap; }
.policy-src { font-size: 0.8rem; }
.policy-src a { color: var(--accent); }
.policy-status {
  --c: var(--ink-3);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.68rem;
  line-height: 1.5;
  padding: 0.05rem 0.5rem;
  border-radius: 999px;
  border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
  background: color-mix(in srgb, var(--c) 10%, transparent);
  color: color-mix(in srgb, var(--c) 70%, var(--ink));
  white-space: nowrap;
}
.policy-status--allowed, .policy-status--required-round { --c: var(--diff-intermediate); }
.policy-status--some-rounds, .policy-status--pilot, .policy-status--banned-except { --c: var(--diff-advanced); }
.policy-status--banned { --c: var(--diff-extreme); }

/* Phones: one stacked block per company instead of a 40rem table that hides the
   policy text off to the right. Column names move into small inline labels. */
@media (max-width: 640px) {
  .policy { min-width: 0; }
  .policy thead {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .policy, .policy tbody, .policy tr, .policy th, .policy td { display: block; }
  .policy tbody tr { padding: 0.8rem 0.9rem; border-bottom: 1px solid var(--line); }
  .policy tbody tr:last-child { border-bottom: none; }
  .policy tbody th, .policy td { padding: 0; border-bottom: none; }
  .policy tbody th { white-space: normal; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 0.5rem; }
  .policy-kind { display: inline; }
  .policy-cell-status { margin-top: 0.35rem; }
  .policy-status { display: inline-block; white-space: normal; }
  .policy-detail { min-width: 0; margin-top: 0.4rem; }
  .policy-date, .policy-src { margin-top: 0.3rem; white-space: normal; }
  .policy td[data-label]::before {
    content: attr(data-label);
    content: attr(data-label) / "";
    display: inline-block;
    min-width: 4.25rem;
    font-family: 'Geist', ui-sans-serif, system-ui, sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
}
</style>
