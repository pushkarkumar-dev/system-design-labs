---
// The site author's own view. Only the author writes this section.
//   <MyTake pending />            placeholder until the author writes it
//   <MyTake>Markdown…</MyTake>    the real thing
// A published walkthrough may keep <MyTake pending />. In production builds the
// placeholder renders nothing and walkthroughs/[id].astro drops the "My take" heading
// and TOC entry; in dev and PUBLIC_SHOW_DRAFTS builds the placeholder shows.
import { SHOW_DRAFTS } from '../../lib/interviews/data';

interface Props { pending?: boolean }
const { pending = false } = Astro.props;
const hide = pending && !SHOW_DRAFTS;
---
{hide ? null : pending ? (
  <div class="mytake mytake--pending" role="note">
    <p class="mytake-label">Author's take — to be written</p>
    <p class="mytake-text">
      This section is written by the site author: opinions, experience, and where they disagree with
      the standard answer. Until it's written, the published site leaves this section out.
    </p>
  </div>
) : (
  <div class="mytake">
    <p class="mytake-label">My take</p>
    <div class="mytake-body"><slot /></div>
  </div>
)}

<style>
.mytake {
  margin: 1.25rem 0;
  padding: 0.9rem 1.1rem;
  border-radius: var(--r-md);
  border: 1px solid var(--accent-line);
  background: var(--accent-soft);
}
.mytake--pending {
  border: 2px dashed color-mix(in srgb, var(--diff-advanced) 60%, transparent);
  background: transparent;
}
.mytake-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--accent);
  margin: 0 0 0.35rem;
}
.mytake--pending .mytake-label { color: color-mix(in srgb, var(--diff-advanced) 75%, var(--ink)); }
.mytake-text { margin: 0; font-size: 0.9rem; color: var(--ink-3); }
.mytake-body { color: var(--ink-2); }
.mytake-body :global(p:last-child) { margin-bottom: 0; }
</style>
