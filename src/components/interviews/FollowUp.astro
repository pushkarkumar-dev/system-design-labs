---
// One follow-up question; the answer (markdown) is the slot. Use inside <FollowUps>.
//   <FollowUp q="How do you stop short requests waiting behind long ones?">Answer…</FollowUp>
interface Props { q: string; open?: boolean }
const { q, open = false } = Astro.props;
if (!q) throw new Error(`[interviews] <FollowUp> on ${Astro.url.pathname}: the q prop (the follow-up question) is required.`);
---
<details class="fu" open={open}>
  <summary class="fu-q">{q}</summary>
  <div class="fu-a"><slot /></div>
</details>

<style>
.fu {
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  background: var(--bg-card);
}
.fu[open] { border-color: var(--line-2); }
.fu-q {
  cursor: pointer;
  list-style: none;
  padding: 0.6rem 0.85rem 0.6rem 2rem;
  position: relative;
  color: var(--ink);
  font-weight: 500;
  font-size: 0.93rem;
}
.fu-q::-webkit-details-marker { display: none; }
.fu-q::before {
  content: '+';
  position: absolute;
  left: 0.8rem;
  top: 0.55rem;
  font-family: 'JetBrains Mono', monospace;
  color: var(--accent);
}
.fu[open] > .fu-q::before { content: '−'; }
.fu-q:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-sm); }
.fu-a { padding: 0 0.85rem 0.75rem 2rem; font-size: 0.9rem; color: var(--ink-2); }
.fu-a :global(p:last-child) { margin-bottom: 0; }
</style>
