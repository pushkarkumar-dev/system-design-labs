---
// Two columns: what a Senior answer does vs what a Staff answer adds. Stacks on mobile.
//   <LevelContrast
//     title="Batching"
//     senior={["Sizes the batch from the latency budget.", "…"]}
//     staff={["Asks who owns the latency budget and what breaks first.", "…"]}
//   />
// Instead of the arrays you can pass markdown through named slots:
//   <LevelContrast><Fragment slot="senior">…</Fragment><Fragment slot="staff">…</Fragment></LevelContrast>

interface Props {
  title?: string;
  senior?: string[];
  staff?: string[];
}
const { title, senior = [], staff = [] } = Astro.props;
const hasSeniorSlot = Astro.slots.has('senior');
const hasStaffSlot = Astro.slots.has('staff');
if ((!senior.length && !hasSeniorSlot) || (!staff.length && !hasStaffSlot)) {
  throw new Error(`[interviews] <LevelContrast${title ? ` title="${title}"` : ''}> on ${Astro.url.pathname}: needs both a senior and a staff side (props or slots).`);
}
---
<section class="lc" aria-label={title ? `Senior vs Staff: ${title}` : 'Senior vs Staff'}>
  {title && <p class="lc-title">{title}</p>}
  <div class="lc-grid">
    <div class="lc-col lc-col--senior">
      <p class="lc-label">Senior</p>
      {hasSeniorSlot ? <div class="lc-slot"><slot name="senior" /></div> : (
        <ul>{senior.map((s) => <li>{s}</li>)}</ul>
      )}
    </div>
    <div class="lc-col lc-col--staff">
      <p class="lc-label">Staff</p>
      {hasStaffSlot ? <div class="lc-slot"><slot name="staff" /></div> : (
        <ul>{staff.map((s) => <li>{s}</li>)}</ul>
      )}
    </div>
  </div>
</section>

<style>
.lc { margin: 1.5rem 0; }
.lc-title {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
  margin: 0 0 0.5rem;
}
.lc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
.lc-col {
  border: 1px solid var(--line-2);
  border-radius: var(--r-md);
  background: var(--bg-card);
  padding: 0.85rem 1rem;
  min-width: 0;
}
.lc-col--staff { border-color: var(--accent-line); background: color-mix(in srgb, var(--accent) 5%, var(--bg-card)); }
.lc-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.72rem;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--ink-3);
  margin: 0 0 0.4rem;
}
.lc-col--staff .lc-label { color: var(--accent); }
.lc-col ul { margin: 0; padding-left: 1.1rem; }
.lc-col li { margin: 0 0 0.35rem; font-size: 0.9rem; }
.lc-slot :global(p:last-child) { margin-bottom: 0; }
@media (max-width: 640px) {
  .lc-grid { grid-template-columns: minmax(0, 1fr); }
}
</style>
