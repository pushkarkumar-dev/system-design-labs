---
// One row of filter chips for src/scripts/chip-filter.ts. Put it inside a filter root
// (<div data-chip-filter="#list" hidden>); the script reveals the root and wires it up.
//   <ChipGroup name="track" label="Track" options={[{ value: 'ai-infra', label: 'AI Infra', count: 12 }]} />
// `name` is both the URL param and the item attribute it matches (data-<name>).
interface Option { value: string; label: string; count?: number }
interface Props {
  name: string;
  label: string;
  options: Option[];
  /** Label of the "no filter" chip. */
  allLabel?: string;
  /** Allow several chips at once (OR-ed). */
  multi?: boolean;
}
const { name, label, options, allLabel = 'All', multi = false } = Astro.props;
const labelId = `chipgroup-${name}-label`;
---
<div class="chipgroup" data-chip-group={name} data-multi={multi ? '' : undefined}>
  <span class="chipgroup-label" id={labelId}>{label}</span>
  <div class="chipgroup-chips" role="group" aria-labelledby={labelId}>
    <button type="button" class="chip chip--active" data-value="" aria-pressed="true">{allLabel}</button>
    {options.map((o) => (
      <button type="button" class="chip" data-value={o.value} aria-pressed="false">
        {o.label}{typeof o.count === 'number' && <span class="chip-count">{o.count}</span>}
      </button>
    ))}
  </div>
</div>

<script>
  import '../../scripts/chip-filter';
</script>

<style>
.chipgroup { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
.chipgroup-label {
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ink-3);
}
.chipgroup-chips { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  background: transparent;
  border: 1px solid var(--line-2);
  border-radius: 999px;
  color: var(--ink-3);
  font: inherit;
  font-size: 0.75rem;
  line-height: 1.4;
  padding: 0.22rem 0.7rem;
  cursor: pointer;
  /* Long theme names wrap inside the chip on narrow phones instead of overflowing. */
  max-width: 100%;
  text-align: left;
  transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
}
.chip:hover { border-color: var(--accent-line); color: var(--ink); }
.chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.chip--active, .chip[aria-pressed='true'] {
  background: var(--accent-soft);
  border-color: var(--accent-line);
  color: var(--accent);
}
.chip-count { font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; color: var(--ink-4); }
.chip--active .chip-count, .chip[aria-pressed='true'] .chip-count { color: inherit; opacity: 0.75; }
@media (prefers-reduced-motion: reduce) {
  .chip { transition: none; }
}
</style>
